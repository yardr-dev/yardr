#!/bin/bash
# SKETCH. What the yard does in a Linear thread: reply, posted, read, open,
# state. One JSON object on stdin, one on stdout. LINEAR_API_KEY is in the
# environment. Needs curl and jq. The requests were not run against Linear.
set -euo pipefail
in=$(cat)
arg() { jq -r --arg k "$1" '.[$k] // ""' <<<"$in"; }

# gql <query> <variables as JSON>: the data of the answer, or exit 1 with
# Linear's errors on stderr.
gql() {
  local out
  out=$(curl -sS --fail-with-body https://api.linear.app/graphql \
    -H "Authorization: $LINEAR_API_KEY" -H 'Content-Type: application/json' \
    -d "$(jq -n --arg q "$1" --argjson v "$2" '{query: $q, variables: $v}')")
  jq -e '.errors | not' <<<"$out" >/dev/null || { jq -c .errors <<<"$out" >&2; exit 1; }
  jq -c .data <<<"$out"
}

case "$1" in
reply)   # the key is the comment's own id: Linear takes ours, so a retry finds it
  gql 'mutation($i: CommentCreateInput!) { commentCreate(input: $i) { comment { id url } } }' \
      "$(jq '{i: ({id: .key, issueId: .thread, body: .body} + (if .parent then {parentId: .parent} else {} end))}' <<<"$in")" \
    | jq -c .commentCreate.comment ;;

posted)
  gql 'query($id: String!) { comment(id: $id) { id url } }' "$(jq '{id: .key}' <<<"$in")" \
    | jq -c '.comment // {}' ;;

read)    # every page, which a declared call cannot follow
  cursor=null; all='[]'
  while :; do
    page=$(gql 'query($id: String!, $c: String) { issue(id: $id) { comments(first: 100, after: $c) {
                  nodes { id body createdAt user { id name } parent { id } } pageInfo { hasNextPage endCursor } } } }' \
               "$(jq --argjson c "$cursor" '{id: .thread, c: $c}' <<<"$in")")
    all=$(jq -c --argjson a "$all" '$a + .issue.comments.nodes' <<<"$page")
    [ "$(jq -r .issue.comments.pageInfo.hasNextPage <<<"$page")" = true ] || break
    cursor=$(jq .issue.comments.pageInfo.endCursor <<<"$page")
  done
  jq -c '{messages: sort_by(.createdAt)}' <<<"$all" ;;

open)    # the team is given by key or name; the mutation wants its id
  team=$(gql 'query($t: String!) { teams(filter: {or: [{key: {eq: $t}}, {name: {eq: $t}}]}) { nodes { id } } }' \
             "$(jq '{t: .in}' <<<"$in")" | jq -r '.teams.nodes[0].id // ""')
  [ -n "$team" ] || { echo "no team $(arg in)" >&2; exit 1; }
  gql 'mutation($i: IssueCreateInput!) { issueCreate(input: $i) { issue { id title url } } }' \
      "$(jq --arg t "$team" '{i: {id: .key, teamId: $t, title: .title, description: .body}}' <<<"$in")" \
    | jq -c .issueCreate.issue ;;

state)   # started, review or done: each team has its own statuses, so pick one by type
  cur=$(gql 'query($id: String!) { issue(id: $id) { state { id name type position }
               team { states { nodes { id name type position } } } } }' "$(jq '{id: .thread}' <<<"$in")")
  want=$(jq -c --arg s "$(arg state)" '
    .issue.team.states.nodes | sort_by(.position) as $all
    | if   $s == "started" then [$all[] | select(.type == "started")][0]
      elif $s == "review"  then [$all[] | select(.type == "started" and (.name | test("review"; "i")))][0]
      elif $s == "done"    then [$all[] | select(.type == "completed")][0]
      else null end' <<<"$cur")
  [ "$want" != null ] || { echo "this team has no status for $(arg state)" >&2; exit 1; }
  # never backwards: an issue at or past the status stays where it is
  rank='{"triage":0,"backlog":1,"unstarted":2,"started":3,"completed":4,"canceled":4}'
  if jq -e --argjson w "$want" --argjson r "$rank" \
       '.issue.state as $c | $r[$c.type] > $r[$w.type] or ($c.type == $w.type and $c.position >= $w.position)' \
       <<<"$cur" >/dev/null; then
    jq -c '{status: .issue.state.name, moved: false}' <<<"$cur"; exit 0
  fi
  gql 'mutation($id: String!, $s: String!) { issueUpdate(id: $id, input: {stateId: $s}) { issue { state { name } } } }' \
      "$(jq --argjson w "$want" '{id: .thread, s: $w.id}' <<<"$in")" \
    | jq -c '{status: .issueUpdate.issue.state.name, moved: true}' ;;

*) echo "unknown: $1" >&2; exit 2 ;;
esac
