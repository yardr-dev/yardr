# Written by yardr for herdr's server, which serves every yard of this user: `yardr up` with its login flag writes it, `yardr down` with the same flag removes it.
[Unit]
Description=herdr server

[Service]
ExecStart="/Users/jo/.local/bin/herdr" "server"
WorkingDirectory=/Users/jo
Environment="PATH=/Users/jo/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"
Restart=on-failure

[Install]
WantedBy=default.target
