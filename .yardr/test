# and the end of the run. Without $2 it is the whole suite; with $2
# "selection" it is the plain selection plus the six black-box suites.
# The store, dispatch and bdp suites run again over the socket beside
# the first run only when the plain selection holds one of them
# (yardr-022s): over-the-socket behaviour cannot differ from what the
# base passed except through a package none of the three imports, which
# is the same reach the plain run already accepts everywhere else.
# Without a comparable base there is no selection, so they run whole,
# as they always have; otherwise one line says whether the leg runs
# and why. The gate is judged on the plain selection, before the six
# are added: none of the six is one of the three, so adding them first
# would not change it, and judging it first keeps the line honest.
whole() {
  if [ "$2" = selection ]; then
    echo "test: YARDR_LANDING is set, and $1: the selection plus the six black-box suites (contrib/assembly, contrib/peer, contrib/deploy, contrib/server-yard, contrib/isolated-yard, contrib/release)"
