# result, the packages passed and failed, the wall seconds, and the seconds
# queued on the race lock. A note carries it whole (docs/testing.md R4).
summary() {
  if [ "$1" = 0 ]; then res=pass; else res=fail; fi
  echo "test: sh .yardr/test @ $(git rev-parse --short HEAD): $res, $pkgs_ok packages ok, $pkgs_failed failed, $(($(date +%s) - started)) s, waited $waited_total s"
}
# The packages over the 60 s budget (docs/testing.md R1): a directory, the
# bead that brings it under budget, and why it is over. One is over even
# alone, none only in full runs (docs/design/2026-10-16-yardr-635g-test-time.md
# section 2.1 measured two; yardr-2ddt brought assembly under budget, yardr-ab6t cli).
# A race leg that runs one of these over 60 s still passes;
# any other package over 60 s is run again alone, and fails the run when
# over 60 s again on a quiet machine; over again on a loaded one passes
# with the load named, unless YARDR_R1_STRICT is set by the quiet run.
# Then the loaded pass is off: over 60 s alone fails however loaded the
# machine. The fix beads delete the rows;
# a row whose package is gone fails nothing, since no result line maps to
# it, but delete it anyway.
over60='
internal/web yardr-bds8 238 sequential tests, no t.Parallel; 52-54 s beside root and cli (16 Oct), 61-83 s alone (18-19 Oct); TestSteadyClient 16 s, TestBeadsPageManyBeads 7 s (design yardr-bds8 class C)
'
# loadedmachine prints the machine's one-minute load average and core count,
# as "load <avg> on <cores> cores", when the machine is too loaded for a
# timing verdict: the average past the core count. The race lock holds off
# the other gate legs, not every test on the machine, so the budget's alone
# re-run can be loaded too (yardr-wq5h: release and web over budget alone
# beside a Go test and a cargo test). It reads /proc/loadavg and nproc
# where the system keeps them, sysctl's vm.loadavg and hw.ncpu elsewhere,
# as the machine source's limits command does
# (contrib/machine-limits/machine/limits). YARDR_TEST_LOADAVG and
# YARDR_TEST_CORES override the readings, for the gate's own tests. Where
# nothing answers, or the readings are no numbers, it prints nothing and
# fails: unknown load never passes a package.
loadedmachine() {
  if [ -n "$YARDR_TEST_LOADAVG$YARDR_TEST_CORES" ]; then
    avg=$YARDR_TEST_LOADAVG
    cores=$YARDR_TEST_CORES
  elif [ -r /proc/loadavg ]; then
    avg=$(awk '{print $1}' /proc/loadavg)
    cores=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo)
  else
    avg=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
    cores=$(sysctl -n hw.ncpu 2>/dev/null)
  fi
