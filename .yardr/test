#!/bin/sh
# yardr's tests: the depot's test command (yardr depot add yardr . --test
# .yardr/test). A builder and a reviewer run it in their worktree, as it is
# on their branch, before they hand on; the assembly runs main's copy of it
# on what lands (contrib/assembly/merge-local), so an edit to it on a bead's
# branch judges nothing until it has landed.
#
# Run plainly it is meant to take seconds: everything still has to be
# formatted, vetted and built, but only the packages the branch touched, and
# the packages that import those, are tested. A change in a package nearly
# everything imports (store, config) makes it nearly the whole suite, which
# is right; a leaf package takes seconds. It is also what a wagon of a train
# passes to land on its train's branch.
#
# With YARDR_LANDING=1, as the assembly sets it for what lands on main, it is
# the whole suite instead: the race detector on every package, vet for linux
# too, and, when the plain selection holds store, dispatch or bdp, those
# suites again over the socket, beside the first run of the tests. Without a
# comparable base there is no selection and they run whole, as they always
# have. Except
# when the branch changed nothing that is compiled: then every program and
# every test binary is built from the source the base passed the whole suite
# with, only a test that opens a changed file by path can differ, and the
# run is the plain one. The first line says which it is, and why.
#
# What the branch touched is what changed since the base: YARDR_BASE (an
# agent's session and the assembly have it: main, or the train's branch for
# a wagon), else origin/main. The first line of the output says which.
#
# Two budgets (docs/testing.md R1 and R2): a package's tests finish in 60 s
# under -race, and a test sleeps no more than 500 ms at a site. Each has its
# allow-list below, naming why each entry is over and which bead brings it
# under; the fix beads delete the rows. A race leg fails when a package it
# ran is over budget and not allow-listed, and the run fails when a test
# file sleeps over budget at a site that is not.
#
# After each step a line says how many seconds it took (test: go vet ./...
# took 14 s), so a landing's log shows where a run's time went. The run ends
# with its test line, the line a note carries whole: `test: sh .yardr/test @
# <sha>: pass, <n> packages ok, 0 failed, 112 s, waited 40 s` -- the result,
# the packages go test printed `ok` and `FAIL` for across the run's legs, the
# wall seconds, and the seconds queued on the machine-wide race lock
# (docs/testing.md R4 names the fields). A plan (YARDR_TEST_PLAN=1) and a run
# that could not start (exit 2) print none.
#
# A red run ends with the lines that say what failed, since a note carries
# only the end of the output. Exit 2 is "could not run", which the assembly
# holds a bead on instead of sending it back: the base is not there.
#
# YARDR_TEST_PLAN=1 says what the run would test and stops: no gofmt, vet,
# build or test. The test of this script runs it so (yardtest_test.go).
set -e
# The settings of the yard's server are not the tests': a server one of them
# starts would listen on this yard's webhook address (config.ServerSettings).
unset YARDR_HOOK_ADDR YARDR_EVENT_RETENTION YARDR_HOOK_PAYLOAD_RETENTION YARDR_PPROF
# The run's own test line is printed by finish, on exit, from these: the wall
# seconds since started, the race-lock seconds the legs waited, and the
# packages go test printed `ok` and `FAIL` for. tmp is pick's, below.
started=$(date +%s)
waited_total=0 pkgs_ok=0 pkgs_failed=0
tmp=
beside=
beside_counts=
finish() {
  rc=$?
  trap - EXIT
  [ -z "$tmp" ] || [ ! -d "$tmp" ] || rm -rf "$tmp"
  [ -z "$beside" ] || [ ! -e "$beside" ] || rm -f "$beside"
  [ -z "$beside_counts" ] || [ ! -e "$beside_counts" ] || rm -f "$beside_counts"
  # No line for a plan, which stops before the steps, or for exit 2, which is
  # "could not run": the base is not there, and nothing ran.
  if [ -z "$YARDR_TEST_PLAN" ] && [ "$rc" != 2 ]; then
    summary "$rc"
  fi
  exit "$rc"
}
trap 'finish' EXIT
# took says how long a step ($2) took, in whole seconds since $1 (date +%s).
took() { echo "test: $2 took $(($(date +%s) - $1)) s"; }
# listed says how long choosing the packages took, where they were chosen
# (pick).
listing=
listed() { [ -z "$listing" ] || echo "$listing"; }
# again runs a go step, and once more when it failed because a file of Go's
# build cache was gone. Seen on 7 Oct 2026 at 00:46 (yardr-n1v5's landing)
# and at about 00:50 (yardr-k4ky's review): go vet said "could not import ...
# (open ~/Library/Caches/go-build/...-d: no such file or directory)" of
# packages the branch had not touched, and the same commit passed when run
# again. The cache is the user's, one for every run on the machine (GOCACHE
# is not set per run), and several run at once; which of them, or what else,
# took the file is not known. That says nothing about the branch, so it must
# not send the bead back. A second failure stands, whatever it says.
# A go test step that fails runs its failed packages (the FAIL<tab>pkg lines)
# once more, alone, with the same flags; when they pass, the step passes, and
# one line starting with `test: flaky:` names the tests that failed the first
# time (the --- FAIL: names, with their packages). A package that fails twice
# fails the step as before. The plain run does the same: a builder should not
# be sent chasing a flake either. Seen on 14 Oct 2026 (yardr-2nss's landing):
# three packages that fail only under load sent an approved change back to
# new, for a session, two reviews and a 15-minute landing run, all for load.
# What this costs: a test that fails one time in two for a real race now gets
# through a landing half the time. That is the trade; the flaky line in the
# output is what makes it visible, and the yardmaster files a bead from it.
# Do not retry more than once: a cache retry consumes the one retry, and a
# second failure stands.
# The output of both runs is printed, as it comes: the step's stdout and
# stderr go through one pipe to tee, so the exit status is passed in a file
# beside the log. Then the line that says how long the step took, both runs
# of it where there were two. A step that failed for good is followed by what
# of its output says so (failed).
# racelocked runs the race leg under the machine-wide race lock: one go test
# -race run at a time on this machine. Five worktrees' race suites side by
# side on ten cores slow each other past Go's per-package timeout, while one
# alone takes a third of the time, so the queue costs less than the
# contention (yardr-cecb). The lock is an flock on one file under the yard's
# home, which every worktree's gate shares, so a gate that dies releases it;
# never a file the gate removes again, which a dead gate leaves behind
# blocking every landing. The file is the yard's, 0600 in a 0700 home, as
# its other files are. macOS has no flock binary; perl's flock is the
# same call. The perl holds the lock itself while the run, forked without
# the lock's fd, runs under it: nothing the run starts can hold the lock
# past the run, however long it outlives it (an orphaned sleep once did:
# yardr-tsms). The perl exits with the run's status, 128+n for a run ended
# by signal n, and forwards TERM and INT to the run, so a killed gate still
# stops it. It waits without a limit, and says so, with the seconds, when
# it waited.
# A run nested in another's race leg shares its hold instead of waiting on
# it (YARDR_RACE_HELD, which the run's own tests set too): without that the
# tests, which run this script, would wait on the run they are in.
racelocked() {
  lock=$HOME/.yardr/race.lock
  mkdir -p -m 700 "$HOME/.yardr"
  YARDR_RACE_HELD=1
  export YARDR_RACE_HELD
  perl -e 'use Fcntl qw(:DEFAULT :flock);
use POSIX qw(:sys_wait_h);
use Errno qw(EINTR);
$lock = shift;
sysopen(my $fh, $lock, O_WRONLY | O_APPEND | O_CREAT, 0600) or die "test: cannot open $lock: $!\n";
$t = time;
flock($fh, LOCK_EX) or die "test: cannot lock $lock: $!\n";
$w = time - $t;
warn "test: waited $w s for the race lock\n" if $w > 0;
# The run must not inherit the lock: the child closes it before it execs,
# so the lock dies with this process, whatever the run leaves behind.
# TERM and INT go to the run too, so a killed gate still stops it.
$SIG{TERM} = sub { kill("TERM", $pid) if $pid };
$SIG{INT} = sub { kill("INT", $pid) if $pid };
$pid = fork();
die "test: cannot fork: $!\n" unless defined $pid;
if ($pid == 0) {
  close($fh);
  $SIG{TERM} = "DEFAULT";
  $SIG{INT} = "DEFAULT";
  exec(@ARGV);
  die "test: cannot run $ARGV[0]: $!\n";
}
do { $kid = waitpid($pid, 0) } while ($kid == -1 && $! == EINTR);
$st = $?;
$pid = 0;
$SIG{TERM} = "DEFAULT";
$SIG{INT} = "DEFAULT";
if (WIFSIGNALED($st)) { exit(128 + WTERMSIG($st)) }
exit(WEXITSTATUS($st));' "$lock" "$@"
}
again() {
  t0=$(date +%s)
  log=$(mktemp)
  acc=$(mktemp)
  # The race leg, and only it, runs under the machine-wide lock: go vet,
  # go build and the socket leg beside the first run wait for nothing.
  # Its output is also kept whole across runs, for the package budget.
  under=env
  race=0
  case " $* " in
    *" go test -race "*)
      race=1
      if [ -z "$YARDR_RACE_HELD" ]; then
        under=racelocked
      fi
      ;;
  esac
  { rc=0; "$under" "$@" 2>&1 || rc=$?; echo "$rc" >"$log.rc"; } | tee "$log"
  rc=$(cat "$log.rc")
  if [ "$race" = 1 ]; then cat "$log" >>"$acc"; fi
  waited_total=$((waited_total + $(waitcount "$log")))
  step_ok=0
  case " $* " in
    *" go test "*)
      step_ok=$(okcount "$log")
      ;;
  esac
  retried=0
  if [ "$rc" != 0 ] && grep -q 'go-build/.*: no such file or directory' "$log"; then
    echo "test: the Go build cache lost a file under us; running again" >&2
    { rc=0; "$under" "$@" 2>&1 || rc=$?; echo "$rc" >"$log.rc"; } | tee "$log"
    rc=$(cat "$log.rc")
    if [ "$race" = 1 ]; then cat "$log" >>"$acc"; fi
    waited_total=$((waited_total + $(waitcount "$log")))
    case " $* " in
      *" go test "*)
        # The first run is discarded with its log: count this one instead.
        step_ok=$(okcount "$log")
        ;;
    esac
    retried=1
  fi
  if [ "$rc" != 0 ] && [ "$retried" = 0 ]; then
    case " $* " in
      *" go test "*)
        pkgs=$(grep -E '^FAIL[[:space:]]+[^[:space:]]+' "$log" | awk '{print $2}' | sort -u || true)
        if [ -n "$pkgs" ]; then
          tests=$(sed -n 's/.*--- FAIL: \([^ ][^ ]*\).*/\1/p' "$log" | sort -u || true)
          pkgs_line=$(printf '%s\n' "$pkgs" | tr '\n' ' ' | sed 's/ $//' || true)
          tests_line=$(printf '%s\n' "$tests" | tr '\n' ' ' | sed 's/ $//' || true)
          # The same flags, the failed packages only: the prefix up to and
          # including "test" (env ... go test), then the flags (what after
          # test starts with -), then the failed packages. Packages and
          # flags have no spaces.
          prefix=""
          flags=""
          seen_test=0
          for a in "$@"; do
            if [ "$seen_test" = 0 ]; then
              prefix="$prefix $a"
              if [ "$a" = "test" ]; then
                seen_test=1
              fi
            else
              case "$a" in
                -*) flags="$flags $a" ;;
              esac
            fi
          done
          echo "test: running the failed packages again: $pkgs_line" >&2
          # shellcheck disable=SC2086
          { rc=0; "$under" $prefix $flags $pkgs 2>&1 || rc=$?; echo "$rc" >"$log.rc"; } | tee "$log"
          rc=$(cat "$log.rc")
          if [ "$race" = 1 ]; then cat "$log" >>"$acc"; fi
          waited_total=$((waited_total + $(waitcount "$log")))
          # The rerun ran only the failed packages: its passes add to the
          # first run's.
          step_ok=$((step_ok + $(okcount "$log")))
          if [ "$rc" = 0 ]; then
            if [ -n "$tests" ]; then
              echo "test: flaky: $tests_line ($pkgs_line) passed on rerun"
            else
              echo "test: flaky: $pkgs_line passed on rerun"
            fi
          fi
        fi
        ;;
    esac
  fi
  took "$t0" "$*"
  # The package budget, after a green race leg: a leg whose tests failed
  # is already red without it.
  if [ "$rc" = 0 ] && [ "$race" = 1 ]; then
    packagebudget "$acc" || rc=$?
  fi
  [ "$rc" = 0 ] || failed "$log" "$@"
  case " $* " in
    *" go test "*)
      # The failures are the final log's: a package that passed on rerun is
      # passed, not failed.
      pkgs_ok=$((pkgs_ok + step_ok))
      pkgs_failed=$((pkgs_failed + $(failcount "$log")))
      ;;
  esac
  rm -f "$log" "$log.rc" "$acc"
  return "$rc"
}
# failed prints the lines of a failed step's output that say what failed: a
# failing test, package or build, a panic, a race, and what go vet and the
# compiler say (file.go:line:col: message). At most 60, the first ones.
failed() {
  f=$1
  shift
  echo "test: FAILED: $*"
  grep -E -e '--- FAIL' -e '^FAIL' -e 'panic:' -e 'DATA RACE' -e '^[^[:space:]]+\.go:[0-9]+:[0-9]+:' "$f" | head -n 60 || true
}
# waitcount prints the race-lock seconds one step's log ($1) holds: the
# `test: waited N s` lines its race legs printed, 0 when there are none.
waitcount() { grep -E '^test: waited [0-9]+ s for the race lock$' "$1" | awk '{s+=$3} END {print s+0}'; }
# okcount prints the packages one go test log ($1) passed: the `ok` lines. A
# package with no tests prints `?`, not `ok`, and is not counted.
okcount() { grep -c -E '^ok[[:space:]]' "$1" || true; }
# failcount prints the packages one go test log ($1) failed: the FAIL lines,
# as the flaky retry reads them.
failcount() { grep -c -E '^FAIL[[:space:]]+[^[:space:]]+' "$1" || true; }
# summary prints the run's test line ($1 is its exit status: 0 passed): the
# result, the packages passed and failed, the wall seconds, and the seconds
# queued on the race lock. A note carries it whole (docs/testing.md R4).
summary() {
  if [ "$1" = 0 ]; then res=pass; else res=fail; fi
  echo "test: sh .yardr/test @ $(git rev-parse --short HEAD): $res, $pkgs_ok packages ok, $pkgs_failed failed, $(($(date +%s) - started)) s, waited $waited_total s"
}
# The packages over the 60 s budget (docs/testing.md R1): a directory, the
# bead that brings it under budget, and why it is over. Three are over even
# alone, three only in full runs (docs/design/2026-10-16-yardr-635g-test-time.md
# section 2.1). A race leg that runs one of these over 60 s still passes;
# any other package over 60 s fails the run. The fix beads delete the rows;
# a row whose package is gone fails nothing, since no result line maps to
# it, but delete it anyway.
over60='
internal/cli yardr-14tr 769 sequential tests at 0.10 s mean plus 67 parallel; 75 s alone; stdout and env are process globals in cli tests; parallel needs output/config threaded through commands (design yardr-14tr)
contrib/assembly yardr-9df1 the 60 s owner end-to-end test plus the train yards; 92 s alone
internal/store yardr-3cc4 798 sequential tests plus the index walk after every write; 90 s alone
contrib/isolated-yard yardr-mzjv real down-script runs over sleeper processes; 30 s alone, 51-92 s in full runs
contrib/deploy yardr-mzjv 39 tests each starting a server of its own; 22 s alone, 41-61 s in full runs
contrib/release yardr-mzjv the real ./build runs; 36 s alone, 74-121 s in full runs
contrib/shot yardr-c2vt 72.6 s in a loaded full landing run on 16 Oct; alone not yet measured; yardr-c2vt measures it and removes this row or keeps it with the number
'
# packagebudget fails the run when a go test -race leg ran a package over
# the 60 s budget (docs/testing.md R1) that the allow-list above does not
# name. Its input is the leg's output ($1): only the ok lines carry judged
# seconds, a package whose tests failed being already red without it.
# Cached packages print no seconds and are not judged. The allow-list goes
# by file, as the reads table does: awk takes no newline in -v. It says
# which packages, sorted, and returns 1 when there are any.
packagebudget() {
  allow=$(mktemp)
  printf '%s\n' "$over60" >"$allow"
  out=$(awk '
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ /) { dir = $0; sub(/ .*/, "", dir); over[dir] = 1 }
      next
    }
    /^ok[ \t]/ && $3 ~ /^[0-9.]+s$/ {
      pkg = $2; secs = $3; sub(/s$/, "", secs)
      if (pkg == "yardr.dev/yardr") dir = "."
      else if (pkg ~ /^yardr\.dev\/yardr\//) { dir = pkg; sub(/^yardr\.dev\/yardr\//, "", dir) }
      else next
      if (secs + 0 > 60 && !(dir in over) && !(dir in bad)) {
        bad[dir] = 1
        printf "test: %s took %s s with -race, over the 60 s budget (docs/testing.md R1)\n", pkg, secs
      }
    }' "$allow" "$1") || { rm -f "$allow"; return 1; }
  rm -f "$allow"
  if [ -n "$out" ]; then
    printf '%s\n' "$out" | sort
    return 1
  fi
  return 0
}
# The test sleeps over the 500 ms budget (docs/testing.md R2): the file,
# the milliseconds it sleeps, and why it must use the real clock. The gate
# reads literal durations in *_test.go files; a sleep it cannot read, such
# as a variable, is not judged. A row whose site is gone fails nothing
# here; the root package's test counts the rows against the tree, so delete
# the row with the fix. Each row covers one site, including when a file has
# two sleeps with the same duration.
longsleeps='
yardtest_test.go 3000 the race-lock test holds the lock 3 s past the build step so the wait spans whole seconds however slowly the run started
internal/dispatch/harness_reset_test.go 1000 a session age reads the wall clock, not the dispatchers, so the test sleeps past its 1 s max_age
internal/dispatch/failure_test.go 2050 a session age reads the wall clock, so the test sleeps past its 2 s max_age
internal/server/server_test.go 1000 the drain test holds the store past the grace, then releases it
internal/rpc/stream_test.go 600 the blocked write hits its deadline
contrib/assembly/owner_test.go 1000 yardr-9df1 polls once a second for up to 90 s while the owner watch ticks its real minute
contrib/isolated-yard/down_test.go 300000 non-elapsing: the sleeper process waits to be killed at test end
'
# sleepbudget fails the run when a *_test.go file sleeps over the 500 ms
# budget (docs/testing.md R2) at a site the allow-list above does not name.
# A site is time.Sleep with a literal duration: N * time.Unit (N a number)
# or time.Unit alone; anything else is not judged. Line comments are not
# code. The allow-list goes by file, as the reads table does: awk takes no
# newline in -v. It says how many allow-listed sleeps the tree holds, so
# the re-measure can count the real-clock debt.
sleepbudget() {
  t0=$(date +%s)
  st=0
  allow=$(mktemp)
  printf '%s\n' "$longsleeps" >"$allow"
  out=$(grep -rn --include='*_test.go' --exclude-dir=.git 'time\.Sleep(' . 2>/dev/null | awk '
    BEGIN {
      ms["Nanosecond"] = 0.000001
      ms["Microsecond"] = 0.001
      ms["Millisecond"] = 1
      ms["Second"] = 1000
      ms["Minute"] = 60000
      ms["Hour"] = 3600000
    }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ [0-9]+ /) {
        f = $0; sub(/ .*/, "", f)
        m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m)
        over[f SUBSEP m]++
      }
      next
    }
    {
      code = $0; sub(/\/\/.*$/, "", code)
      if (code !~ /time\.Sleep\(/) next
      f = code; sub(/:[0-9]+:.*$/, "", f); sub(/^\.\//, "", f)
      line = code; sub(/^[^:]*:/, "", line); sub(/:.*$/, "", line)
      e = code; sub(/.*time\.Sleep\(/, "", e); sub(/\).*$/, "", e)
      n = e; unit = e
      if (match(e, /\*/)) {
        n = substr(e, 1, RSTART - 1); unit = substr(e, RSTART + RLENGTH)
      } else n = 1
      gsub(/ /, "", n); gsub(/ /, "", unit); sub(/^time\./, "", unit)
      if (n !~ /^[0-9.]+$/ || !(unit in ms)) next
      dur = n * ms[unit]
      if (dur <= 500) next
      key = f SUBSEP dur
      if (key in over) {
        seen[key]++
        if (seen[key] > over[key]) {
          printf "test: %s:%s sleeps %s, over the 500 ms budget (docs/testing.md R2)\n", f, line, e
          bad++
        } else nseen++
        next
      }
      printf "test: %s:%s sleeps %s, over the 500 ms budget (docs/testing.md R2)\n", f, line, e
      bad++
    }
    END {
      if (bad > 0) exit 1
      if (nseen > 0) printf "test: %d sleeps over 500 ms allow-listed\n", nseen
    }' "$allow" -) || st=$?
  rm -f "$allow"
  took "$t0" "sleep budgets"
  if [ -n "$out" ]; then printf '%s\n' "$out"; fi
  [ "$st" = 0 ] || exit 1
}
formatted() {
  t0=$(date +%s)
  out=$(gofmt -l .)
  took "$t0" "gofmt -l ."
  if [ -n "$out" ]; then
    echo "gofmt needed on:"
    echo "$out"
    exit 1
  fi
}
# whole is a landing's whole suite, after a line that says why it is that
# ($1), and the end of the run. The store, dispatch and bdp suites run again
# over the socket beside the first run only when the plain selection holds
# one of them (yardr-022s): over-the-socket behaviour cannot differ from what
# the base passed except through a package none of the three imports, which
# is the same reach the plain run already accepts everywhere else. Without a
# comparable base there is no selection, so they run whole, as they always
# have; otherwise one line says whether the leg runs and why.
whole() {
  echo "test: YARDR_LANDING is set, and $1: the whole suite"
  leg=beside
  if [ -n "$from" ]; then
    # The gate: the plain selection, which a landing over an embedded or
    # embedded file already picked on its way here. An unrecognized file
    # makes the plain run test every package, as do go.mod and go.sum, so the
    # socket suites are in that selection too.
    [ -n "$tmp" ] || pick
    holds=""
    if [ -s "$tmp/stray" ]; then
      holds="store dispatch bdp"
    else
      for s in store dispatch bdp; do
        if grep -q "/internal/$s\$" "$tmp/run"; then
          holds="$holds${holds:+ }$s"
        fi
      done
    fi
    if [ -n "$holds" ]; then
      echo "test: the plain selection holds $holds: running the socket suites beside the first run"
    else
      echo "test: the plain selection holds neither store, dispatch nor bdp: skipping the socket suites"
      leg=skip
    fi
  else
    echo "test: no comparable base: running the socket suites beside the first run"
  fi
  [ -z "$YARDR_TEST_PLAN" ] || exit 0
  listed
  # gofmt first: CI fails on it, so this must too.
  formatted
  again go vet ./...
  # CI runs on linux and this on a Mac: a darwin-only syscall.Getsid got
  # through (yardr-mrdt). vet cross-compiles, so no linux machine is needed.
  again env GOOS=linux go vet ./...
  sleepbudget
  # The same suites through the unix-socket client, beside the first run and
  # not after it (yardr-9xd9): both mostly wait, so a landing is as long as
  # the slower of the two instead of their sum. The socket step's output is
  # kept in a file and printed when the first has ended, so that each step's
  # output stays whole. It runs whether the first is green or not, and the
  # run is red when either is.
  # env, not an assignment before again: whether that reaches what a function
  # runs differs between shells.
  if [ "$leg" = beside ]; then
    beside=$(mktemp)
    beside_counts=$(mktemp)
    {
      second=0
      again env YARDR_TEST_RPC=1 go test ./internal/store/ ./internal/dispatch/ ./internal/bdp/ || second=$?
      printf '%s %s\n' "$pkgs_ok" "$pkgs_failed" >"$beside_counts"
      exit "$second"
    } >"$beside" 2>&1 &
    socket=$!
  fi
  first=0
  again go test -race ./... || first=$?
  if [ "$leg" != beside ]; then
    exit "$first"
  fi
  second=0
  wait "$socket" || second=$?
  cat "$beside"
  # The socket leg ran in the background, so its retry-aware counts are its
  # own copy. Read those instead of counting the raw output: a flaky package
  # appears as FAIL on the first run and ok on the retry.
  read -r side_ok side_failed <"$beside_counts"
  pkgs_ok=$((pkgs_ok + side_ok))
  pkgs_failed=$((pkgs_failed + side_failed))
  rm -f "$beside" "$beside_counts"
  beside= beside_counts=
  [ "$first" = 0 ] || exit "$first"
  exit "$second"
}
# What the branch changed: against the base, from where the branch left it.
# For a wagon of a train that is the tip of its train's branch, so a wagon is
# tested for what it changed, not for the train's earlier wagons again.
# Without the base nothing can be told apart, which must not read as "nothing
# changed": a plain run could not run, and a landing is the whole suite (CI's
# checkout has one commit and no origin/main).
if [ -n "$YARDR_BASE" ]; then
  base=$YARDR_BASE said="YARDR_BASE"
else
  base=origin/main said="the default, YARDR_BASE not being set"
fi
from=$(git merge-base "$base" HEAD) || from=
if [ -z "$from" ]; then
  if [ -n "$YARDR_LANDING" ]; then
    whole "$base ($said) is no commit here, or has none in common with HEAD"
  fi
  echo "test: cannot compare with $base ($said): no such commit here, or none in common with HEAD" >&2
  exit 2
fi
since="since $base ($said), from $(git rev-parse --short "$from")"
# Files a test reads by path. go list knows what a package imports and
# embeds, not what its tests open (os.ReadFile("../../packs/starter/pack.yaml")),
# so that is written down here: a path, then the directories of the packages
# whose tests read it, or - when no test does. A path ending in / is
# everything under that directory; any other is that one file. Every row a
# changed file matches fires, and its packages' own tests run (not their
# importers: nothing was compiled differently).
# Add a row when a test starts reading a file outside what its package
# compiles in: `grep -rn '"\.\./' --include='*_test.go' .` finds most, a
# helper that walks up to the repository (storetest.RepoFlow) the rest. A
# changed file that is not .go, not embedded and in no row tests every
# package, so a missing row costs time, not a fault found late; a row that
# leaves a reader out is what lets one through. A - row is a promise that no
# test reads the path: check before adding one.
# The . on the contrib rows is the root package, whose test reads every .go
# file of the repository (main_test.go): a package the binary imports runs
# it as an importer does, and contrib's programs are imported by nothing.
# It also follows every link of the README to its page and heading, so the
# README and docs/ name it.
reads='
packs/starter/                 internal/pack internal/cli
packs/design/                  contrib/assembly
packs/contributors/            contrib/assembly
packs/dir/                     internal/pack
packs/linear/                  internal/hooks internal/dispatch
packs/github/                  internal/hooks
packs/template/                internal/pack packs
.yardr/flows/                  internal/cli internal/dispatch internal/store internal/flowdraw contrib/assembly
.yardr/test                    .
internal/hooks/testdata/       internal/hooks internal/dispatch
internal/cli/testdata/         internal/cli
internal/web/assets/README.md  internal/web
contrib/assembly/merge-local   internal/pack
contrib/assembly/              contrib/assembly .
contrib/shot/shot              internal/pack
contrib/shot/                  contrib/shot .
contrib/deploy/                contrib/deploy .
contrib/github-mint/           contrib/github-mint .
contrib/machine-limits/        contrib/machine-limits .
contrib/peer/                  contrib/peer .
contrib/isolated-yard/sources/crm.yaml internal/cli
contrib/isolated-yard/         contrib/isolated-yard .
contrib/server-yard/           contrib/server-yard .
contrib/release/               contrib/release .
README.md                      contrib/release .
LICENSE                        contrib/release .
NOTICE                         contrib/release
docs/pushover.md               internal/cli
docs/integrations.md           internal/cli packs
docs/groups.md                 internal/agents
docs/api.md                    internal/rpc
docs/packs.md                  packs
docs/flows/                    internal/flowdraw internal/cli
docs/                          .
.yardr/depot.md                -
.yardr/roles/                  -
.github/                       -
.github/workflows/release.yml  contrib/release
.gitignore                     -
conformance/                   -
'
built() {
  [ -z "$YARDR_TEST_PLAN" ] || return 0
  formatted
  again go vet ./...
  again go build ./...
  sleepbudget
}
changed=$(git diff --name-only "$from")
# What is tested, with the race detector: the packages that changed, and
# every package that imports one of them, however far up, since a change
# breaks its importers as easily as itself. go list knows both, with the
# test files counted (-test): each package and test variant with its
# directory, the files it embeds and everything it depends on (Deps is
# already transitive, so no walk is needed: a package is in when one of its
# Deps changed). A package changed when a .go file in its directory did, or
# a file it embeds, which is compiled in like one. A file the branch
# deleted is in no package's list any more, so what remains under the same
# directory stands for it: a deleted file under a directory some package
# still embeds counts as that package's change. A _test.go file is
# imported by nobody: it runs its own package's tests only. Any other file
# is no package's: the table above says whose tests read it, and a file the
# table does not know either runs every package.
# pick leaves it in $tmp: run has the packages, rows the lines for the rows
# that fired, stray the first file the table does not know and how many more
# there are, embedded the first changed file a package embeds.
pick() {
tmp=$(mktemp -d)
printf '%s\n' "$reads" >"$tmp/reads"
printf '%s\n' "$changed" >"$tmp/changed"
git diff --name-only --diff-filter=D "$from" >"$tmp/deleted"
t0=$(date +%s)
go list -test -f '{{.ImportPath}}|{{.Dir}}|{{join .Deps ","}}|{{join .EmbedFiles ","}},{{join .TestEmbedFiles ","}},{{join .XTestEmbedFiles ","}}' ./... >"$tmp/pkgs"
# Said by listed, after the run's first line, which a landing prints only
# once it has this list. A plan says what would be tested, and no more.
[ -n "$YARDR_TEST_PLAN" ] || listing=$(took "$t0" "go list -test ./...")
# Not in a pipe or a $(...): a go list or awk that fails must fail the run,
# not read as an empty list.
awk -F'|' -v root="$(git rev-parse --show-toplevel)" -v rows="$tmp/rows" -v stray="$tmp/stray" -v embedded="$tmp/embedded" '
  # "p [p.test]", "p_test [p.test]" and "p.test" are all package p.
  function base(p) { sub(/ \[.*/, "", p); sub(/\.test$/, "", p); sub(/_test$/, "", p); return p }
  FILENAME == ARGV[1] { if (split($0, w, " ") > 1) { r++; at[r] = w[1]; by[r] = w[2]; for (i = 3; i in w; i++) by[r] = by[r] " " w[i] } next }
  FILENAME == ARGV[2] { if ($0 != "") gone[$0] = 1; next }
  FILENAME == ARGV[3] { if ($0 != "") { file[$0] = 1; order[++nf] = $0; if ($0 ~ /\.go$/) { gd = $0; if (!sub(/\/[^\/]*$/, "", gd)) gd = "."; if ($0 ~ /_test\.go$/) testdir[gd] = 1; else godir[gd] = 1 } } next }
  {
    n++; path[n] = base($1); deps[n] = $3
    dir = substr($2, length(root) + 2); if (dir == "") dir = "."
    indir[dir] = path[n]
    if (dir in godir) hit[path[n]] = 1
    if (dir in testdir) run[path[n]] = 1
    m = split($4, e, ",")
    for (i = 1; i <= m; i++) if (e[i] != "") {
      f = (dir == "." ? "" : dir "/") e[i]
      if (f in file) { hit[path[n]] = 1; known[f] = 1 }
      parent = f
      while (sub(/\/[^\/]*$/, "", parent)) {
        if (parent == dir) break
        for (del in gone) if (index(del, parent "/") == 1) { hit[path[n]] = 1; known[del] = 1 }
      }
    }
  }
  END {
    for (k = 1; k <= n; k++) {
      if (path[k] in hit) { run[path[k]] = 1; continue }
      m = split(deps[k], d, ",")
      for (i = 1; i <= m; i++) if (base(d[i]) in hit) { run[path[k]] = 1; break }
    }
    # The table: which rows the changed files fire, and which changed file
    # nothing accounts for. A row naming a directory that is no package
    # fails the run whether it fired or not, so a stale row is found by
    # the next run, not by the change it would have missed.
    for (j = 1; j <= r; j++) {
      m = split(by[j], d, " ")
      for (i = 1; i <= m; i++) if (d[i] != "-" && !(d[i] in indir)) { print "test: the row for " at[j] " in .yardr/test names " d[i] ", which is no package here" >"/dev/stderr"; bad = 1 }
    }
    if (bad) exit 1
    for (k = 1; k <= nf; k++) {
      f = order[k]; rowed = 0
      for (j = 1; j <= r; j++) if (at[j] ~ /\/$/ ? index(f, at[j]) == 1 : f == at[j]) { rowed = 1; if (!fired[j]++) first[j] = f }
      if (!rowed && f !~ /\.go$/ && !(f in known) && !strays++) print f >stray
      if (f in known && !embeds++) print f >embedded
    }
    if (strays > 1) print strays - 1 >stray
    for (j = 1; j <= r; j++) if (fired[j]) {
      m = split(by[j], d, " ")
      for (i = 1; i <= m; i++) if (d[i] != "-") run[indir[d[i]]] = 1
      print "test: " first[j] (fired[j] > 1 ? " and " fired[j] - 1 " more under " at[j] : "") (by[j] == "-" ? " changed: no test reads it" : " changed: read by the tests of " by[j]) >rows
    }
    for (p in run) print p
  }' "$tmp/reads" "$tmp/deleted" "$tmp/changed" "$tmp/pkgs" >"$tmp/run"
}
if [ -n "$YARDR_LANDING" ]; then
  # A landing is the whole suite unless nothing compiled changed. What is
  # compiled: a .go file, go.mod and go.sum, and a file a package embeds. A
  # file the table does not know may be read by any test, as in a plain run.
  # A deleted file is no longer in any package's list of what it embeds, so
  # it cannot be told whether it was. And a landing that changes nothing at
  # all is somebody asking for the whole suite (CI on main, a release).
  # go list is asked only when no .go file changed: the source it reads is
  # then the base's.
  if [ -z "$changed" ]; then
    whole "nothing changed $since"
  fi
  file=$(printf '%s\n' "$changed" | grep -x -e go.mod -e go.sum -e '.*\.go' | head -n 1)
  if [ -n "$file" ]; then
    whole "$file changed $since"
  fi
  file=$(git diff --name-only --diff-filter=D "$from" | head -n 1)
  if [ -n "$file" ]; then
    whole "$file was deleted $since"
  fi
  pick
  if [ -s "$tmp/embedded" ]; then
    whole "$(cat "$tmp/embedded"), which a package embeds, changed $since"
  fi
  if [ -s "$tmp/stray" ]; then
    read -r file <"$tmp/stray"
    whole "$file, which is read by no known package, changed $since"
  fi
  echo "test: YARDR_LANDING is set, and nothing compiled changed $since"
  listed
  built
else
  echo "test: what changed $since"
  built
  # go.mod or go.sum moves every package.
  if printf '%s\n' "$changed" | grep -qx -e go.mod -e go.sum; then
    echo "test: go.mod or go.sum changed; testing every package"
    [ -z "$YARDR_TEST_PLAN" ] || exit 0
    again go test -race ./...
    exit 0
  fi
  pick
  listed
  if [ -s "$tmp/stray" ]; then
    { read -r file; read -r more || more=; } <"$tmp/stray"
    echo "test: $file${more:+ (and $more more)} is read by no known package: testing everything"
    [ -z "$YARDR_TEST_PLAN" ] || exit 0
    again go test -race ./...
    exit 0
  fi
fi
[ ! -s "$tmp/rows" ] || cat "$tmp/rows"
pkgs=$(sort "$tmp/run")
if [ -z "$pkgs" ]; then
  echo "test: no package changed since $(git rev-parse --short "$from"); no tests to run"
  exit 0
fi
# shellcheck disable=SC2086
echo "test: testing, with -race, what changed, what imports it and what reads it:" $pkgs
[ -z "$YARDR_TEST_PLAN" ] || exit 0
# shellcheck disable=SC2086
again go test -race $pkgs
