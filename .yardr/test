          else if (s ~ /^ms/) { total += n / 1000; sub(/^ms/, "", s) }
          else if (s ~ /^m/) { total += n * 60; sub(/^m/, "", s) }
          else if (s ~ /^µs/) { total += n / 1000000; sub(/^µs/, "", s) }
          else if (s ~ /^us/) { total += n / 1000000; sub(/^us/, "", s) }
          else if (s ~ /^ns/) { total += n / 1000000000; sub(/^ns/, "", s) }
          else if (s ~ /^s/) { total += n; sub(/^s/, "", s) }
