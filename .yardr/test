# The test sleeps over the 500 ms budget (docs/testing.md R2): the file,
# the milliseconds it sleeps, and why it must use the real clock. The gate
# reads literal durations in *_test.go files; a sleep it cannot read, such
# as a variable, is not judged. A row whose site is gone fails nothing
# here; the root package's test counts the rows against the tree, so delete
# the row with the fix. Each row covers one site, including when a file has
# two sleeps with the same duration.
longsleeps='
internal/dispatch/harness_reset_test.go 1000 a session age reads the wall clock, not the dispatchers, so the test sleeps past its 1 s max_age
internal/dispatch/failure_test.go 2050 a session age reads the wall clock, so the test sleeps past its 2 s max_age
internal/server/server_test.go 1000 the drain test holds the store past the grace, then releases it
internal/rpc/stream_test.go 600 the blocked write hits its deadline
contrib/isolated-yard/down_test.go 300000 non-elapsing: the sleeper process waits to be killed at test end
'
# sleepbudget fails the run when a *_test.go file sleeps over the 500 ms
# budget (docs/testing.md R2) at a site the allow-list above does not name.
# A site is time.Sleep with a literal duration: N * time.Unit (N a number)
# or time.Unit alone; anything else is not judged. Line comments are not
# code. The allow-list goes by file, as the reads table does: awk takes no
# newline in -v. It says how many allow-listed sleeps the tree holds, so
# the re-measure can count the real-clock debt.
sleepbudget() {
  t0=$(date +%s)
  st=0
  allow=$(mktemp)
  printf '%s\n' "$longsleeps" >"$allow"
  out=$(grep -rn --include='*_test.go' --exclude-dir=.git 'time\.Sleep(' . 2>/dev/null | awk '
    BEGIN {
      ms["Nanosecond"] = 0.000001
      ms["Microsecond"] = 0.001
      ms["Millisecond"] = 1
      ms["Second"] = 1000
      ms["Minute"] = 60000
      ms["Hour"] = 3600000
    }
    FILENAME == ARGV[1] {
      if ($0 ~ /^[^ ]+ [0-9]+ /) {
        f = $0; sub(/ .*/, "", f)
        m = $0; sub(/^[^ ]+ /, "", m); sub(/ .*/, "", m)
        over[f SUBSEP m]++
      }
      next
    }
    {
      code = $0; sub(/\/\/.*$/, "", code)
      if (code !~ /time\.Sleep\(/) next
      f = code; sub(/:[0-9]+:.*$/, "", f); sub(/^\.\//, "", f)
      line = code; sub(/^[^:]*:/, "", line); sub(/:.*$/, "", line)
      e = code; sub(/.*time\.Sleep\(/, "", e); sub(/\).*$/, "", e)
      n = e; unit = e
      if (match(e, /\*/)) {
        n = substr(e, 1, RSTART - 1); unit = substr(e, RSTART + RLENGTH)
      } else n = 1
      gsub(/ /, "", n); gsub(/ /, "", unit); sub(/^time\./, "", unit)
