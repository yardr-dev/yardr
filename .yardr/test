#!/bin/sh
# yardr's tests: the depot's test command (yardr depot add yardr . --test
# .yardr/test). A builder and a reviewer run it in their worktree, as it is
# on their branch, before they hand on; the assembly runs main's copy of it
# on what lands (contrib/assembly/merge-local), so an edit to it on a bead's
# branch judges nothing until it has landed.
#
# Run plainly it is meant to take seconds: everything still has to be
# formatted, vetted and built, but only the packages the branch touched, and
# the packages that import those, are tested. A change in a package nearly
# everything imports (store, config) makes it nearly the whole suite, which
# is right; a leaf package takes seconds. It is also what a wagon of a train
# passes to land on its train's branch.
#
# With YARDR_LANDING=1, as the assembly sets it for what lands on main, a
# landing that changes code runs the plain selection plus always the six
# black-box suites (docs/testing.md R5), vet for linux too, and, when the
# plain selection holds store, dispatch or bdp, those suites again over
# the socket, beside the first run of the tests. The whole suite still
# runs when there is no comparable base, when nothing changed, and when
# what changed cannot be selected: go.mod or go.sum, a deletion, or a
# file no row knows, each of which the selection itself would test as
# everything. When the branch changed nothing that is compiled, every
# program and every test binary is built from the source the base
# passed with, only a test that opens a changed file by path can
# differ, and the run is the plain selection alone. The whole suite
# otherwise runs only when the yard is quiet (docs/testing.md R6) and
# where someone runs YARDR_LANDING=1 on the base itself. The first
# line says which run it is, and why.
#
# What the branch touched is what changed since the base: YARDR_BASE (an
# agent's session and the assembly have it: main, or the train's branch for
# a wagon), else origin/main. The first line of the output says which.
#
# Two budgets (docs/testing.md R1 and R2): a package's tests finish in 60 s
# under -race, and a test sleeps no more than 500 ms at a site. Each has its
# allow-list below, naming why each entry is over and which bead brings it
# under; the fix beads delete the rows. A race leg runs a package it ran
# over budget and not allow-listed again by itself: over budget alone on a
# quiet machine fails the run; on a loaded machine it passes with an R1 line
# naming both times and the load, unless YARDR_R1_STRICT is set by the quiet
# run. Then over budget alone fails however loaded the machine, and on a
# loaded machine the failure line names the load beside both times;
# the run fails when a test file sleeps over budget at a site that is not.
#
# After each step a line says how many seconds it took (test: go vet ./...
# took 14 s), so a landing's log shows where a run's time went. The run ends
# with its test line, the line a note carries whole: `test: sh .yardr/test @
# <sha>: pass, <n> packages ok, 0 failed, 112 s, waited 40 s` -- the result,
# the packages go test printed `ok` and `FAIL` for across the run's legs, the
# wall seconds, and the seconds queued on the machine-wide race lock
# (docs/testing.md R4 names the fields). A plan (YARDR_TEST_PLAN=1) and a run
# that could not start (exit 2) print none.
#
# A red run ends with the lines that say what failed, since a note carries
# only the end of the output. Exit 2 is "could not run", which the assembly
# holds a bead on instead of sending it back: the base is not there.
#
# YARDR_TEST_PLAN=1 says what the run would test and stops: no gofmt, vet,
# build or test. The test of this script runs it so (yardtest_test.go).
set -e
# The settings of the yard's server are not the tests': a server one of them
# starts would listen on this yard's webhook address (config.ServerSettings).
unset YARDR_HOOK_ADDR YARDR_EVENT_RETENTION YARDR_HOOK_PAYLOAD_RETENTION YARDR_PPROF
# The run's own test line is printed by finish, on exit, from these: the wall
# seconds since started, the race-lock seconds the legs waited, and the
# packages go test printed `ok` and `FAIL` for. tmp is pick's, below.
started=$(date +%s)
waited_total=0 pkgs_ok=0 pkgs_failed=0
tmp=
beside=
beside_counts=
finish() {
  rc=$?
  trap - EXIT
  [ -z "$tmp" ] || [ ! -d "$tmp" ] || rm -rf "$tmp"
  [ -z "$beside" ] || [ ! -e "$beside" ] || rm -f "$beside"
  [ -z "$beside_counts" ] || [ ! -e "$beside_counts" ] || rm -f "$beside_counts"
  # No line for a plan, which stops before the steps, or for exit 2, which is
  # "could not run": the base is not there, and nothing ran.
  if [ -z "$YARDR_TEST_PLAN" ] && [ "$rc" != 2 ]; then
    summary "$rc"
  fi
  exit "$rc"
}
trap 'finish' EXIT
# took says how long a step ($2) took, in whole seconds since $1 (date +%s).
took() { echo "test: $2 took $(($(date +%s) - $1)) s"; }
# listed says how long choosing the packages took, where they were chosen
# (pick).
listing=
listed() { [ -z "$listing" ] || echo "$listing"; }
# again runs a go step, and once more when it failed because a file of Go's
# build cache was gone. Seen on 7 Oct 2026 at 00:46 (yardr-n1v5's landing)
# and at about 00:50 (yardr-k4ky's review): go vet said "could not import ...
# (open ~/Library/Caches/go-build/...-d: no such file or directory)" of
# packages the branch had not touched, and the same commit passed when run
# again. The cache is the user's, one for every run on the machine (GOCACHE
# is not set per run), and several run at once; which of them, or what else,
# took the file is not known. That says nothing about the branch, so it must
# not send the bead back. A second failure stands, whatever it says.
# A go test step that fails runs its failed packages (the FAIL<tab>pkg lines)
# once more, alone, with the same flags; when they pass, the step passes, and
# one line starting with `test: flaky:` names the tests that failed the first
# time (the --- FAIL: names, with their packages). A package that fails twice
# fails the step as before. The plain run does the same: a builder should not
# be sent chasing a flake either. Seen on 14 Oct 2026 (yardr-2nss's landing):
# three packages that fail only under load sent an approved change back to
# new, for a session, two reviews and a 15-minute landing run, all for load.
# What this costs: a test that fails one time in two for a real race now gets
# through a landing half the time. That is the trade; the flaky line in the
# output is what makes it visible, and one line per flaky line is appended
# to yardr-flaky.log in the git common dir, which the repo owns and every
# worktree shares. AGENTS.md says when that line becomes a bead.
# Do not retry more than once: a cache retry consumes the one retry, and a
# second failure stands.
# A step's output is kept in its log and printed. Outside the race worker it
# streams through tee; inside it is captured in a file first. A test can leave
# an orphan holding stdout open, so the worker must not use a pipe for go
# commands: that would keep tee and the lock holder alive after go test exits.
# Then the line that says how long the step took, both runs of it where there
# were two. A step that failed for good is followed by what of its output says so.
runlogged() {
  runlog=$1
  shift
  if [ -n "$race_leg_child" ]; then
    runstatus=0
    "$@" >"$runlog" 2>&1 || runstatus=$?
    cat "$runlog"
    return "$runstatus"
  fi
  { runstatus=0; "$@" 2>&1 || runstatus=$?; echo "$runstatus" >"$runlog.rc"; } | tee "$runlog"
  runstatus=$(cat "$runlog.rc")
  return "$runstatus"
}
# racelocked runs the race leg under the machine-wide race lock: one go test
# -race run at a time on this machine. Five worktrees' race suites side by
# side on ten cores slow each other past Go's per-package timeout, while one
# alone takes a third of the time, so the queue costs less than the
# contention (yardr-cecb). The lock is an flock on one file under the yard's
# home, which every worktree's gate shares, so a gate that dies releases it;
# never a file the gate removes again, which a dead gate leaves behind
# blocking every landing. The file is the yard's, 0600 in a 0700 home, as
# its other files are. macOS has no flock binary; perl's flock is the
# same call.
# In front of the flock is a ticket queue, so waiters take the lock in
# arrival order: each writes a timestamped ticket with its pid, start time,
# bead and worktree, and only the oldest live ticket may take the flock. A
# dead waiter's ticket is skipped and removed. Waiting gates print their
# place and the holder at once and then each minute. The holder records
# itself beside the lock for that line.
# sh .yardr/test --race-queue shows the holder and waiters, oldest first,
# without creating a ticket or leaving a lock held.
# The perl holds the lock itself while the worker it forked runs
# the race leg under it: the worker closes the lock's fd before it execs,
# so nothing the leg starts can hold the lock past the leg, however long it
# outlives it (an orphaned sleep once did: yardr-tsms). It runs in its own
# process group, so TERM and INT stop its children too. One hold covers the
# leg, its failed-test retry and the package-budget re-measurement, which
# share it through YARDR_RACE_HELD instead of waiting on it again. The perl
# exits with the worker's status, 128+n for a worker ended by signal n, and
# forwards TERM and INT to it, so a killed gate still stops the leg. It
# waits without a limit, and says so, with the seconds, when it waited.
# A run nested in another's race leg shares its hold instead of waiting on
# it (YARDR_RACE_HELD, which the run's own tests set too): without that the
# tests, which run this script, would wait on the run they are in.
racelocked() {
  lock=$HOME/.yardr/race.lock
  if [ "$1" = "--show-queue" ]; then
    mode=--show-queue
  else
    mode=
    status=$1
    shift
    mkdir -p -m 700 "$HOME/.yardr"
  fi
  race_perl='use POSIX qw(:sys_wait_h setpgid);
use Fcntl qw(:DEFAULT :flock);
use Errno qw(EINTR EWOULDBLOCK EAGAIN);
use Time::HiRes qw(gettimeofday);
$lock = shift;
$yard = $lock;
$yard =~ s{/[^/]+$}{};
$yard = "." if $yard eq $lock;
$qdir = "$yard/race.queue";
$holder = "$yard/race.holder";
# How a queued pid is told live: /proc where the kernel has it, else ps
# where ps can stat this process, else a bare kill, as the yard liveness
# checks do where the OS tells no start time.
$have_proc = (-d "/proc" && -f "/proc/self/stat") ? 1 : 0;
$have_ps = 0;
if (!$have_proc) {
  my $probe = qx(ps -p $$ -o lstart= 2>/dev/null);
  $have_ps = 1 if defined($probe) && $probe =~ /\S/;
}
# proc_stat is what the OS says of a pid: its state letter, its start
# time (compared for equality only) and whether a process is there at
# all. An undef start means the OS told none: the pid stands alone.
sub proc_stat {
  my ($pid) = @_;
  return (undef, undef, 0) unless defined($pid) && $pid =~ /^\d+$/ && $pid > 0;
  if ($have_proc) {
    open(my $fh, "<", "/proc/$pid/stat") or return (undef, undef, 0);
    my $line = <$fh>;
    close($fh);
    if (defined($line) && $line =~ /\)\s+(.*)$/) {
      my @f = split(/\s+/, $1);
      return (substr($f[0], 0, 1), $f[19], 1) if @f >= 20;
    }
    return (undef, undef, 1);
  }
  if ($have_ps) {
    my $out = qx(ps -p $pid -o state= -o lstart= 2>/dev/null);
    if ($? == -1) {
      return (undef, undef, kill(0, $pid) ? 1 : 0);
    }
    return (undef, undef, 0) unless defined($out) && $out =~ /\S/;
    if ($out =~ /^\s*(\S+)\s+(.+?)\s*$/) {
      return (substr($1, 0, 1), $2, 1);
    }
    return (undef, undef, 1);
  }
  return (undef, undef, kill(0, $pid) ? 1 : 0);
}
# alive tells a queued pid from a later process that reused it: the pid
# is there, not a zombie, and where both start times are known they
# match. A recorded start of "" is from where the OS told none.
sub alive {
  my ($pid, $recorded) = @_;
  my ($state, $start, $exists) = proc_stat($pid);
  return 0 unless $exists;
  return 0 if defined($state) && $state eq "Z";
  if (defined($recorded) && $recorded ne "" && defined($start) && $start ne "") {
    return 0 unless $start eq $recorded;
  }
  return 1;
}
sub my_start {
  my (undef, $start, undef) = proc_stat($$);
  return defined($start) ? $start : "";
}
# read_kv parses a ticket or holder file, key=value a line; undef when
# the file is gone.
sub read_kv {
  my ($path) = @_;
  open(my $fh, "<", $path) or return undef;
  my %kv;
  while (my $line = <$fh>) {
    chomp($line);
    $kv{$1} = $2 if $line =~ /^([a-z]+)=(.*)$/;
  }
  close($fh);
  return \%kv;
}
# ids is the pid and recorded start a queue entry names: from its
# content, or the filename pid where the content is not readable.
sub ids {
  my ($name) = @_;
  my $kv = read_kv("$qdir/$name");
  my ($fpid) = $name =~ /-(\d+)$/;
  my $pid = (defined($kv) && defined($kv->{pid}) && $kv->{pid} =~ /^\d+$/) ? $kv->{pid} : $fpid;
  my $start = (defined($kv) && defined($kv->{start})) ? $kv->{start} : "";
  return ($pid, $start, $kv);
}
# queued names the queue entries oldest first: zero-padded seconds and
# nanoseconds, then the pid, so the names sort in arrival order.
sub queued {
  opendir(my $dh, $qdir) or return ();
  my @names = sort grep(/^\d+-\d+$/, readdir($dh));
  closedir($dh);
  return @names;
}
# front is the oldest live ticket, dead ones ahead of it removed; ()
# when the queue is empty.
sub front {
  for my $n (queued()) {
    my ($pid, $start, $kv) = ids($n);
    return ($n, $kv) if alive($pid, $start);
    unlink("$qdir/$n");
  }
  return ();
}
# fullclean removes every dead ticket but $mine, which needs no check.
sub fullclean {
  my ($mine) = @_;
  for my $n (queued()) {
    next if defined($mine) && $n eq $mine;
    my ($pid, $start) = ids($n);
    unlink("$qdir/$n") unless alive($pid, $start);
  }
}
# place counts the live tickets ahead of $mine, plus one; dead ones
# found on the way are removed.
sub place {
  my ($mine) = @_;
  my $n = 1;
  for my $t (queued()) {
    last if $t ge $mine;
    my ($pid, $start) = ids($t);
    if (alive($pid, $start)) { $n++ } else { unlink("$qdir/$t") }
  }
  return $n;
}
sub ordinal {
  my ($n) = @_;
  return "${n}th" if $n % 100 >= 11 && $n % 100 <= 13;
  my $d = $n % 10;
  return "${n}st" if $d == 1;
  return "${n}nd" if $d == 2;
  return "${n}rd" if $d == 3;
  return "${n}th";
}
sub fmt_age {
  my ($s) = @_;
  $s = 0 if !defined($s) || $s < 0;
  return "$s s" if $s < 60;
  return sprintf("%d m", int($s / 60)) if $s < 3600;
  return sprintf("%d h %d m", int($s / 3600), int(($s % 3600) / 60));
}
# who names a ticket or holder for a line: its bead, else its pid.
sub who {
  my ($kv, $pid) = @_;
  my $bead = (defined($kv) && defined($kv->{bead})) ? $kv->{bead} : "";
  return $bead if $bead ne "";
  return "pid $pid";
}
# holder_info names the live holder and its age, or () when none is recorded.
sub holder_info {
  my $kv = read_kv($holder);
  return () unless defined($kv);
  return () unless alive($kv->{pid}, $kv->{start});
  my $since = (defined($kv->{since}) && $kv->{since} =~ /^\d+$/) ? $kv->{since} : time;
  return (who($kv, $kv->{pid}), fmt_age(time - $since));
}
# identity is the bead and worktree this run records in its ticket and
# its holder file.
sub identity {
  my $bead = defined($ENV{YARDR_BEAD}) ? $ENV{YARDR_BEAD} : "";
  my $dir = POSIX::getcwd();
  $dir = defined($ENV{PWD}) ? $ENV{PWD} : "" unless defined($dir);
  $bead =~ s/[\r\n]+/ /g;
  $dir =~ s/[\r\n]+/ /g;
  return ($bead, $dir);
}
# mkticket queues this waiter behind the tickets there are: a file
# <seconds><nanoseconds>-<pid> holding its pid and start time, its bead
# and its worktree. It arrives by rename, so a listing never sees it
# half written.
sub mkticket {
  if (!-d $qdir) {
    mkdir($qdir, 0700) or $!{EEXIST} or die "test: cannot make $qdir: $!\n";
  }
  my ($s, $us) = gettimeofday();
  my $name = sprintf("%010d%09d-%d", $s, $us * 1000, $$);
  my ($bead, $dir) = identity();
  my $start = my_start();
  for (1..10) {
    my $tmp = "$qdir/.tmp-$$-$s-" . int(rand(1000000));
    if (sysopen(my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL, 0600)) {
      print $fh "pid=$$\nstart=$start\nbead=$bead\ndir=$dir\ncreated=$s\n";
      if (!close($fh)) { unlink($tmp); die "test: cannot write $tmp: $!\n"; }
      # The ticket is named in $mine before it shows, not by the caller once
      # mkticket returns: cleanup goes by $mine, and a TERM handled between
      # the rename and that assignment left the ticket in the queue (once in
      # 300 waiters killed as their ticket showed, on a loaded machine;
      # yardr-m1br).
      $mine = $name;
      if (!rename($tmp, "$qdir/$name")) { unlink($tmp); die "test: cannot queue in $qdir: $!\n"; }
      return $name;
    }
    die "test: cannot write in $qdir: $!\n" unless $!{EEXIST};
  }
  die "test: cannot write in $qdir: no name free\n";
}
# write_holder records this holder beside the lock: its pid and start,
# its bead, its worktree and when it took the lock. It is read for
# display only: a reader that finds it half written or stale says the
# holder is unknown, and the queue never waits on it.
sub write_holder {
  my ($bead, $dir) = identity();
  sysopen(my $fh, $holder, O_WRONLY | O_CREAT | O_TRUNC, 0600) or do { cleanup(); die "test: cannot write $holder: $!\n"; };
  print $fh "pid=$$\nstart=" . my_start() . "\nbead=$bead\ndir=$dir\nsince=" . time . "\n";
  close($fh) or do { cleanup(); die "test: cannot write $holder: $!\n"; };
}
# cleanup leaves the queue as this waiter found it: its ticket and any
# temporary file it was writing are gone, and the holder file is gone
# where it names this holder. The pid in temporary names lets a TERM or
# INT remove one created before it had a ticket name; a KILL leaves a
# ticket the next waiter skips and removes.
sub cleanup {
  unlink("$qdir/$mine") if defined($mine);
  if (opendir(my $dh, $qdir)) {
    for my $name (readdir($dh)) {
      unlink("$qdir/$name") if $name =~ /^\Q.tmp-$$-\E/;
    }
    closedir($dh);
  }
  my $kv = read_kv($holder);
  if (defined($kv) && defined($kv->{pid}) && $kv->{pid} eq $$) {
    my $ms = my_start();
    my $hs = defined($kv->{start}) ? $kv->{start} : "";
    unlink($holder) if $hs eq "" || $ms eq "" || $hs eq $ms;
  }
}
# status_line says where this waiter stands and who holds the lock, as
# in: test: race lock: 3rd in line, held by yardr-cayh for 6 m.
sub status_line {
  my ($me) = @_;
  my $ord = ordinal(place($me));
  my ($who, $age) = holder_info();
  if (defined($who)) {
    warn "test: race lock: $ord in line, held by $who for $age\n";
  } else {
    warn "test: race lock: $ord in line, holder unknown\n";
  }
}
# show_queue prints the holder and the waiters with their beads and
# ages, without waiting for or leaving the lock held: the --race-queue
# view. Dead tickets are skipped, not removed.
sub show_queue {
  my $hkv = read_kv($holder);
  my $live = defined($hkv) && alive($hkv->{pid}, $hkv->{start});
  my $held;
  my $why = "";
  if (sysopen(my $fh, $lock, O_RDONLY)) {
    if (flock($fh, LOCK_EX | LOCK_NB)) {
      $held = 0;
      flock($fh, LOCK_UN);
    } elsif ($!{EWOULDBLOCK} || $!{EAGAIN}) {
      $held = 1;
    } else {
      $held = undef;
      $why = "$!";
    }
    close($fh);
  } elsif ($!{ENOENT}) {
    $held = 0;
  } else {
    $held = undef;
    $why = "$!";
  }
  if ($live) {
    my $since = (defined($hkv->{since}) && $hkv->{since} =~ /^\d+$/) ? $hkv->{since} : time;
    my $hdir = defined($hkv->{dir}) ? $hkv->{dir} : "?";
    print "test: race lock: held by " . who($hkv, $hkv->{pid}) . " for " . fmt_age(time - $since) . " ($hdir)\n";
  } elsif ($held) {
    print "test: race lock: held, holder unknown\n";
  } elsif (defined($held) && !$held) {
    print "test: race lock: free\n";
  } else {
    print "test: race lock: state unknown: cannot probe $lock: $why\n";
  }
  my $i = 0;
  for my $n (queued()) {
    my ($pid, $start, $kv) = ids($n);
    next unless alive($pid, $start);
    # The holder keeps its ticket until exit so queued runs count it in
    # their place. Show it above as the holder, not again as a waiter.
    next if $live && defined($hkv->{pid}) && defined($pid) && $pid eq $hkv->{pid}
      && (!defined($hkv->{start}) || $hkv->{start} eq "" || !defined($start) || $start eq "" || $start eq $hkv->{start});
    $i++;
    my ($cs) = $n =~ /^(\d{10})/;
    my $age = defined($cs) ? time - $cs : 0;
    my $dir = (defined($kv) && defined($kv->{dir})) ? $kv->{dir} : "?";
    print "test: race lock: " . ordinal($i) . " in line: " . who($kv, $pid) . " waiting " . fmt_age($age) . " ($dir)\n";
  }
}
if (@ARGV && $ARGV[0] eq "--show-queue") {
  show_queue();
  exit(0);
}
$script = shift;
$status = shift;
sysopen(my $fh, $lock, O_WRONLY | O_APPEND | O_CREAT, 0600) or die "test: cannot open $lock: $!\n";
$SIG{TERM} = sub { cleanup(); exit(143); };
$SIG{INT} = sub { cleanup(); exit(130); };
$t = time;
$mine = mkticket();
$waiting = 0;
$status_at = 0;
for (;;) {
  if (!-e "$qdir/$mine") {
    $mine = mkticket();
    next;
  }
  my ($first) = front();
  if (defined($first) && $first eq $mine) {
    if (flock($fh, LOCK_EX | LOCK_NB)) {
      fullclean($mine);
      my ($again) = front();
      if (defined($again) && $again eq $mine) {
        last;
      }
      flock($fh, LOCK_UN);
    } elsif ($!{EINTR} || $!{EWOULDBLOCK} || $!{EAGAIN}) {
      # Busy or interrupted: wait.
    } else {
      my $e = "$!";
      cleanup();
      die "test: cannot lock $lock: $e\n";
    }
  }
  if (!$waiting) {
    # The landing timeout needs to credit a lock wait even when it lasts
    # longer than the timeout, before this process can print its final wait.
    warn "test: race lock wait started at $t\n";
    $waiting = 1;
  }
  if ($status_at == 0 || time - $status_at >= 60) {
    status_line($mine);
    $status_at = time;
  }
  sleep(1);
}
$w = time - $t;
warn "test: waited $w s for the race lock\n" if $w > 0 || $waiting;
write_holder();
$ENV{YARDR_RACE_HELD} = 1;
$ENV{YARDR_TEST_RACE_LEG} = 1;
# The worker must not inherit the lock: the child closes it before it
# execs, so the lock dies with this process, whatever the worker leaves
# behind. TERM and INT go to the worker too, so a killed gate still stops
# the leg.
sub forward {
  my $signal = shift;
  if ($pid) { kill($signal, -$pid) || kill($signal, $pid) }
}
$SIG{TERM} = sub { forward("TERM") };
$SIG{INT} = sub { forward("INT") };
$pid = fork();
if (!defined($pid)) { cleanup(); die "test: cannot fork: $!\n"; }
if ($pid == 0) {
  setpgid(0, 0) or die "test: cannot set worker process group: $!\n";
  close($fh);
  $SIG{TERM} = "DEFAULT";
  $SIG{INT} = "DEFAULT";
  exec("/bin/sh", $script, $status, @ARGV);
