# The six black-box suites (docs/testing.md R5): each builds the tree's
# binary and drives it without importing the changed packages, so the
# plain selection alone misses them. A landing that changes code runs
# them always, beside what the selection picked. Their directories, in
# the order the log names them.
blackbox='contrib/assembly contrib/peer contrib/deploy contrib/server-yard contrib/isolated-yard contrib/release'
# addblackbox adds the six suites' packages to the selection in $tmp/run:
# the import path of each directory, from the list pick already made, so
# the run holds each once however the selection named it. A suite that
# is no package here fails the run: silently skipping it would reopen
# the hole the six close.
addblackbox() {
  root=$(git rev-parse --show-toplevel)
  for d in $blackbox; do
    p=$(awk -F'|' -v root="$root" -v want="$d" '
      {
        dir = substr($2, length(root) + 2); if (dir == "") dir = "."
        if (dir == want) { p = $1; sub(/ \[.*/, "", p); sub(/\.test$/, "", p); sub(/_test$/, "", p); print p; exit }
      }' "$tmp/pkgs")
    if [ -z "$p" ]; then
      echo "test: the black-box suite $d is no package here" >&2
      exit 1
    fi
    grep -qx "$p" "$tmp/run" || echo "$p" >>"$tmp/run"
  done
