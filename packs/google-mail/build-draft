#!/bin/bash
# build-draft: the draft and draft_edit calls' request body, built from to,
# cc, subject, body and an optional thread, or passed through from raw. One
# JSON object on stdin, {"params": {...}}, one on stdout, {message: {raw[,
# threadId]}} for a draft, {id, message: {...}} for a draft_edit, where the
# id names the draft to replace. Where a thread is given the script reads
# its last message first, with the yard's credential: GOOGLE_TOKEN and
# YARDR_SOURCE_BASE, the declaration's base, are in the environment. Needs
# curl and jq; base64 and tr from the system's core tools.
#
# Two shapes, never mixed: the composed shape (to, subject and body, with
# cc and a thread to answer beside them) or raw alone, the whole RFC 2822
# message base64url-encoded, wrapped untouched. A draft_edit gives its id
# beside either shape. Anything else is refused in words, and nothing is
# sent.
#
# The yard writes the draft; sending stays the person's. No From is set:
# the account the credential names is the sender, and Gmail fills it in.
set -euo pipefail
in=$(cat)
refuse() { echo "$1" >&2; exit 1; }
param_into() {
  local key="$1" name="$2" value
  # Command substitution drops trailing newlines. Keep a sentinel after the
  # exact JSON string so headers can reject them and the body can preserve them.
  value=$(jq -rj --arg k "$key" '.params[$k] // ""' <<<"$in"; printf '\034')
  printf -v "$name" '%s' "${value%$'\034'}"
}
given() { jq -e --arg k "$1" '(.params // {}) | has($k)' <<<"$in" >/dev/null; }
curl_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}
gmail_get() { # $1 path and query, $2 what the words name: one GET with the credential
  # The token goes to curl as a config line on its stdin, as telegram's
  # thread script hands it: an argument can be read by every process on the
  # machine while curl runs.
  local out code detail
  # Silent, not show-errors: the refusal below carries the words, and
  # curl's own line would stand in front of them.
  out=$(
    {
      printf 'url = '
      curl_quote "$YARDR_SOURCE_BASE$1"
      printf '\nheader = '
      curl_quote "Authorization: Bearer $GOOGLE_TOKEN"
      printf '\n'
    } | curl -s --fail-with-body -K -
  ) || {
    code=$?
    detail=$(jq -r '.error.message // empty' <<<"$out" 2>/dev/null || true)
    [ -n "$detail" ] || detail="curl exit $code"
    refuse "$2 could not be read: $detail"
  }
  printf '%s' "$out"
}

raw_given=""
if given raw; then raw_given=1; fi
composed=""
for p in to cc subject body thread; do
  if given "$p"; then composed="$composed$p, "; fi
done
if [ -n "$raw_given" ] && [ -n "$composed" ]; then
  refuse "raw was given with ${composed%, }: pass raw alone, or to, subject and body"
fi
# The draft to replace, given by a draft_edit beside either shape and by no
# draft: where it is there the body carries it, where not the draft's shape
# goes out unchanged.
draft_id=""
if given id; then param_into id draft_id; fi
if [ -n "$raw_given" ]; then
  # The escape hatch: raw is the whole message already, base64url-encoded
  # by the caller, and goes to Gmail untouched, with no thread of its own.
  param_into raw raw
  if [ -n "$draft_id" ]; then
    jq -c -n --arg id "$draft_id" --arg raw "$raw" '{id: $id, message: {raw: $raw}}'
  else
    jq -c -n --arg raw "$raw" '{message: {raw: $raw}}'
  fi
  exit 0
fi
missing=""
for p in to subject body; do
  if ! given "$p"; then missing="$missing$p, "; fi
done
if [ -n "$missing" ]; then
  refuse "a draft is to, subject and body, or raw alone; missing: ${missing%, }"
fi
param_into to to
param_into cc cc
param_into subject subject
param_into body body
param_into thread thread

# A header is one line: a line break in to, cc or subject would smuggle a
# header of the caller's choosing (a Bcc) into the message. An address is
# ASCII: an addr-spec holds no encoded word, so one outside it is refused
# rather than encoded.
linebreak() { # $1 field, $2 value
  case "$2" in *$'\n'*|*$'\r'*) refuse "$1 holds a line break: a header is one line";; esac
}
linebreak to "$to"
[ -z "$cc" ] || linebreak cc "$cc"
linebreak subject "$subject"
ascii() { # $1 field, $2 value
  if [[ "$2" == *[^[:ascii:]]* ]]; then refuse "$1 holds a character outside ASCII: addresses are ASCII"; fi
}
ascii to "$to"
[ -z "$cc" ] || ascii cc "$cc"
case "$to" in *[[:space:][:cntrl:]]*) refuse "to holds whitespace or a control character: addresses are one token";; esac
[ -z "$cc" ] || case "$cc" in *[[:space:][:cntrl:]]*) refuse "cc holds whitespace or a control character: addresses are one token";; esac

msgid=""
if [ -n "$thread" ]; then
  : "${GOOGLE_TOKEN:?GOOGLE_TOKEN is not set}"
  : "${YARDR_SOURCE_BASE:?YARDR_SOURCE_BASE is not set}"
  # The reply answers the thread's last message: its id from the thread in
  # minimal form (ids alone, however long the thread), then its headers for
  # the Message-ID the reply points at.
  list=$(gmail_get "/gmail/v1/users/me/threads/$thread?format=minimal" "thread $thread")
  last=$(jq -rj '(.messages // []) | if length == 0 then "" else (.[-1].id // "") end' <<<"$list"; printf '\034')
  last=${last%$'\034'}
  [ -n "$last" ] || refuse "thread $thread holds no message to answer"
  case "$last" in *[!0123456789abcdef]*) refuse "thread $thread holds an invalid message id";; esac
  [ "${#last}" -le 64 ] || refuse "thread $thread holds an invalid message id"
  msg=$(gmail_get "/gmail/v1/users/me/messages/$last?format=metadata" "message $last")
  msgid=$(jq -rj '(.payload.headers // []) | map(select((.name | ascii_downcase) == "message-id") | .value) | first // ""' <<<"$msg"; printf '\034')
  msgid=${msgid%$'\034'}
  [ -n "$msgid" ] || refuse "message $last has no Message-ID header to answer"
  linebreak "message $last Message-ID" "$msgid"
fi

# The subject goes out plain where it is ASCII, and as RFC 2047 encoded
# words where it is not: =?UTF-8?B?<base64>?= in pieces of at most 45
# UTF-8 bytes, each whole characters (a character split across two words
# reads as two replacements in a decoder that decodes each word alone),
# folded one word per line.
subject_header="Subject: $subject"
if [[ "$subject" == *[^[:ascii:]]* ]]; then
  words=$(jq -n -r --arg s "$subject" '
    def bytelen: if . < 128 then 1 elif . < 2048 then 2 elif . < 65536 then 3 else 4 end;
    ($s | explode) as $cps
    | (reduce range(0; $cps | length) as $i ([[], [], 0];
        ($cps[$i] | bytelen) as $b
        | .[2] as $n
        | if $n + $b > 45 then [.[0] + [.[1]], [$cps[$i]], $b]
          else [.[0], .[1] + [$cps[$i]], $n + $b] end)) as $acc
    | (($acc[0] + [$acc[1]]) | map(select(length > 0) | implode)) as $words
    | $words | map("=?UTF-8?B?\(. | @base64)?=") | join("\n ")')
  subject_header="Subject: $words"
fi
mime="To: $to"
[ -z "$cc" ] || mime+=$'\n'"Cc: $cc"
mime+=$'\n'"$subject_header"
[ -z "$msgid" ] || mime+=$'\n'"In-Reply-To: $msgid"$'\n'"References: $msgid"
# Encode the text part as well: a UTF-8 charset alone does not change MIME's
# default 7-bit transfer encoding, and bodies may contain non-ASCII text.
encoded_body=$(printf '%s' "$body" | base64)
mime+=$'\n'"MIME-Version: 1.0"$'\n'"Content-Type: text/plain; charset=UTF-8"$'\n'"Content-Transfer-Encoding: base64"$'\n\n'"$encoded_body"$'\n'

# base64url, Gmail's raw: standard base64 without padding or newlines, +/
# as -_. The recipe is the pack's SETUP.md's.
raw=$(printf '%s' "$mime" | base64 | tr -d '=\n' | tr '+/' '-_')
if [ -n "$draft_id" ]; then
  if [ -n "$thread" ]; then
    jq -c -n --arg id "$draft_id" --arg raw "$raw" --arg thread "$thread" '{id: $id, message: {raw: $raw, threadId: $thread}}'
  else
    jq -c -n --arg id "$draft_id" --arg raw "$raw" '{id: $id, message: {raw: $raw}}'
  fi
elif [ -n "$thread" ]; then
  jq -c -n --arg raw "$raw" --arg thread "$thread" '{message: {raw: $raw, threadId: $thread}}'
else
  jq -c -n --arg raw "$raw" '{message: {raw: $raw}}'
fi
