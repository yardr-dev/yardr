#!/bin/sh
# A verified PostHog webhook destination body to the yard's envelope:
# stdin {"headers":{…},"body":{…}}, stdout the envelope. Needs jq.
# internal/hooks feeds it the bodies its tests recorded and compares the
# envelopes with the shapes below.
#
# The body is the destination's JSON body as the setup has it: the
# template's default {event, person} with the project added
# ({"event": "{event}", "person": "{person}", "project": "{project}"}),
# since the default names no project. An $error_tracking_issue_created
# event becomes type error_issue in the thread of its issue, with the
# triggering exception's session and its replay link in its fields when
# the event carries one; a `survey sent` event becomes type feedback
# with the answer as its text, the event's uuid as its thread, and the
# survey, the sender's email, the footplate version and the OS in its
# fields when the delivery carries them; any other body becomes type
# event, so a delivery the destination was not matched for (a test from
# its page) is recorded and routed as today, and never refused with a
# 400 the service retries. Nothing of the body is ever printed to stderr.
exec jq -c '
def obj: if type == "object" then . else {} end;
def str($v): if ($v | type) == "string" then $v elif $v == null then "" else "\($v)" end;
# trunc is hooks.truncate: whitespace collapsed, at most 500 runes. The jq
# POSIX space class includes the Unicode spaces split by Go strings.Fields.
def trunc: (gsub("^[[:space:]]+|[[:space:]]+$"; "") | gsub("[[:space:]]+"; " ")) | if length > 500 then .[0:499] + "…" else . end;

(.body | if type == "object" then . else error("posthog webhook body is not an object") end) as $b
| ($b.event | obj) as $e
| (($b.project | obj).id | str(.)) as $project
| ((($b.project | obj).url | str(.)) | sub("/+$"; "")) as $base
| (if $project != "" then {project: [$project]} else null end) as $fields
| if ($e.event // "") == "$error_tracking_issue_created" then
    # The issue is the distinct_id; its properties carry the same id as
    # $exception_issue_id, which stands in where no distinct_id came.
    ((($e.distinct_id // "") | if type == "string" then . else "" end)
     | if . != "" then . else ((($e.properties | obj)."$exception_issue_id" // "") | if type == "string" then . else "" end) end) as $id
    | (($e.properties | obj).name | str(.)) as $name
    | (($e.properties | obj).description | str(.) | trunc) as $text
    # The link is the one place body data leaves as an address a reader
    # follows, so it is made only as PostHog makes it: an https project
    # URL, and the UUID of the issue in its own segment (the id the issue
    # call takes). Another scheme, or an id carrying a slash, query or
    # fragment, makes no link; the issue is still heard, unlinked.
    | (if ($base | test("^https://[^[:space:]]+$")) and ($id | test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"))
       then "\($base)/error-tracking/\($id)" else "" end) as $url
    # The session is the $session_id of the triggering exception, which
    # the event carries under exception_props when the SDK set one (and
    # nowhere when the message was too large to carry it). The replay
    # link is made under the same guard as the issue link: an https
    # project URL and a UUID session. Another shape is still heard as
    # the session, with no link for a reader to follow.
    | ((($e.properties | obj).exception_props | obj)["$session_id"] | if type == "string" then . else "" end) as $session
    | (if ($base | test("^https://[^[:space:]]+$")) and ($session | test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"))
       then "\($base)/replay/\($session)" else "" end) as $replay
    | ((if $fields == null then {} else $fields end)
       | (if $session != "" then . + {session: [$session]} else . end)
       | (if $replay != "" then . + {replay: [$replay]} else . end)) as $all
    # The thread is the project and the issue, which the state command
    # splits back into its path; without a project it is empty, so a move
    # reads the thread from the issue URL instead, and never ":uuid".
    | (if $project != "" then "\($project):\($id)" else "" end) as $thread
    # No mentions: the description is an error message, and an @word in
    # one names nobody. The entity is the issue, whose description
    # persists across its deliveries.
    | {source: "posthog", type: "error_issue", action: "created",
       actor: {}, thread: {id: $thread, title: $name, url: $url},
       text: $text, url: $url, entity: $id, mentions: []}
    | if ($all | length) == 0 then . else . + {fields: $all} end
  elif ($e.event // "") == "survey sent" then
    # Footplate feedback arrives as the survey shape: $survey_id names
    # the survey the subscription filters on, and the answer
    # is the bare $survey_response of a one-question capture, else the
    # one $survey_response_<question id> value the delivery carries (the
    # first in key order, where several came). An empty bare answer falls
    # back to the keyed one, so the message is never dropped for a blank.
    # No mentions: a message naming @word names nobody here. No URL is
    # made from body data, and the submission stands alone, with no
    # entity: each delivery is heard once, in the thread of its own uuid.
    (($e.properties | obj)) as $props
    | ($props."$survey_response") as $bare
    | ([($props | to_entries[] | select(.key | test("^\\$survey_response_.+")) | .key)] | sort) as $keyed
    | (if ($keyed | length) > 0 then $props[$keyed[0]] else null end) as $keyedval
    | (if ($bare | type) == "string" and $bare != "" then $bare
       elif $bare != null and ($bare | type) != "string" then str($bare)
       else str($keyedval) end | trunc) as $text
    | (($props."$survey_id" | if type == "string" then . else "" end)) as $survey
    | (($props.email | if type == "string" then . else "" end)) as $email
    | (($props.footplate_version | if type == "string" then . else "" end)) as $version
    | (($props.os | if type == "string" then . else "" end)) as $os
    | ((if $fields == null then {} else $fields end)
       | (if $survey != "" then . + {survey: [$survey]} else . end)
       | (if $email != "" then . + {email: [$email]} else . end)
       | (if $version != "" then . + {footplate_version: [$version]} else . end)
       | (if $os != "" then . + {os: [$os]} else . end)) as $all
    | ((($e.uuid // "") | if type == "string" then . else "" end)) as $uuid
    | {source: "posthog", type: "feedback",
       actor: {}, thread: {id: $uuid},
       text: $text, mentions: []}
    | if ($all | length) == 0 then . else . + {fields: $all} end
  else
    {source: "posthog", type: "event", actor: {}, thread: {}, mentions: []}
    | if $fields == null then . else . + {fields: $fields} end
  end
'
