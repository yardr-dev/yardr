#!/bin/sh
# Builds yardr's release archives: one yardr_<version>_<os>_<arch>.tar.gz per
# target, each holding the binary, the README, LICENSE and NOTICE, and a
# checksums.txt (sha256) over them.
#
#   contrib/release/build <version> [out-dir]      (out-dir defaults to dist)
#
# <version> is the tag, v1.2.3 or v1.2.3-rc.1; `yardr version` of the result
# prints it. .github/workflows/release.yml runs this same script, so a
# release made by the workflow and one made by hand cannot drift apart.
#
# YARDR_RELEASE_TARGETS narrows the targets ("darwin/arm64 linux/amd64").
# YARDR_RELEASE_ALLOW_DIRTY=1 lets a build with uncommitted changes through;
# its revision then ends in -modified.
#
# SOURCE_DATE_EPOCH, the seconds since the epoch the archives are stamped
# with, makes the build reproducible: the same inputs make the same bytes.
# .github/workflows/release.yml sets it from the tagged commit, so a tag
# rebuilt makes the release's archives again. Unset, the archives carry
# the time they were packed, as before.
#
# YARDR_RELEASE_SIGN_IDENTITY and YARDR_RELEASE_NOTARY_PROFILE, set together
# on a Mac, sign each darwin binary with that "Developer ID Application"
# identity of the keychain and have Apple notarize it under that notarytool
# keychain profile, before it is packed (docs/install.md, "Making a
# release"). With neither, the darwin binaries are not signed.
#
# YARDR_RELEASE_MINISIGN_KEY, the path of a minisign secret key, signs
# checksums.txt with it and writes checksums.txt.minisig beside it
# (docs/install.md, "Signed checksums"). Unset, the checksums are not signed.
set -eu

usage() {
  echo "usage: contrib/release/build <version> [out-dir]   (version like v1.2.3 or v1.2.3-rc.1)" >&2
  exit 2
}

version=${1:-}
out=${2:-dist}
printf '%s\n' "$version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' || usage
targets=${YARDR_RELEASE_TARGETS:-darwin/arm64 darwin/amd64 linux/amd64 linux/arm64}

# Signing is asked for whole or not at all, and refused here, before the
# first build: a signed binary that is not notarized is one Gatekeeper
# refuses like an unsigned one, and a release that was meant to be signed
# must not come out unsigned for a variable that was forgotten.
identity=${YARDR_RELEASE_SIGN_IDENTITY:-}
profile=${YARDR_RELEASE_NOTARY_PROFILE:-}
if [ -n "$identity" ] && [ -z "$profile" ]; then
  echo "contrib/release/build: YARDR_RELEASE_SIGN_IDENTITY is set and YARDR_RELEASE_NOTARY_PROFILE is not; set both to sign and notarize the darwin binaries, or neither" >&2
  exit 2
fi
if [ -z "$identity" ] && [ -n "$profile" ]; then
  echo "contrib/release/build: YARDR_RELEASE_NOTARY_PROFILE is set and YARDR_RELEASE_SIGN_IDENTITY is not; set both to sign and notarize the darwin binaries, or neither" >&2
  exit 2
fi
if [ -n "$identity" ] && [ "$(uname -s)" != Darwin ]; then
  echo "contrib/release/build: YARDR_RELEASE_SIGN_IDENTITY and YARDR_RELEASE_NOTARY_PROFILE are set, and this is $(uname -s): codesign and notarytool are macOS's; unset both for unsigned darwin binaries" >&2
  exit 2
fi
case " $targets" in
  *" darwin/"*)
    if [ -z "$identity" ]; then
      echo "the darwin binaries are not signed (YARDR_RELEASE_SIGN_IDENTITY and YARDR_RELEASE_NOTARY_PROFILE are not set)"
    fi
    ;;
esac


# The same for the checksums' signature: a key that is named and cannot be
# used fails here, not after four builds and a wait for Apple.
minisign_key=${YARDR_RELEASE_MINISIGN_KEY:-}
if [ -n "$minisign_key" ]; then
  if [ ! -r "$minisign_key" ] || [ -d "$minisign_key" ]; then
    # The value is not printed: one that is the key's text, where its path
    # was meant, would go to the terminal or a workflow's log.
    echo "contrib/release/build: YARDR_RELEASE_MINISIGN_KEY names no file this can read; it is the path of the minisign secret key, or unset for checksums that are not signed" >&2
    exit 2
  fi
  if ! command -v minisign >/dev/null 2>&1; then
    echo "contrib/release/build: YARDR_RELEASE_MINISIGN_KEY is set and there is no minisign on PATH (https://jedisct1.github.io/minisign/); unset it for checksums that are not signed" >&2
    exit 2
  fi
  # The script changes directory below.
  case "$minisign_key" in
    /*) ;;
    *) minisign_key=$PWD/$minisign_key ;;
  esac
else
  echo "checksums.txt is not signed (YARDR_RELEASE_MINISIGN_KEY is not set)"
fi

mkdir -p "$out"
out=$(cd "$out" && pwd)
cd "$(dirname "$0")/../.."

if command -v sha256sum >/dev/null 2>&1; then
  sum="sha256sum"
else
  sum="shasum -a 256"
fi

# An archive holds the listed files and nothing of the machine that packed
# it, so one made on a Mac matches the workflow's. bsdtar there packs a
# file's extended attributes (com.apple.provenance, on anything a Mac made)
# as pax headers and as AppleDouble ._ members, which GNU tar warns of and
# unpacks beside the files; each tar is asked for what it understands, as
# the two do not share the flags. Owner 0/0 and no names, for the same
# reason: not the builder's user and group.
accepts() {
  # shellcheck disable=SC2086 # $1 is a list
  tar -cf /dev/null $1 -T /dev/null 2>/dev/null
}
tarflags="--numeric-owner"
if accepts "--uid 0 --gid 0"; then
  tarflags="$tarflags --uid 0 --gid 0"
else
  tarflags="$tarflags --owner=0 --group=0"
fi
for flag in --no-xattrs --no-mac-metadata; do
  if accepts "$flag"; then
    tarflags="$tarflags $flag"
  fi
done

# A reproducible build stamps every entry with one time and packs them in
# one order. GNU tar takes both as flags; a tar that knows neither (a Mac's)
# still packs identical entries, because the staged files themselves are
# touched to the epoch before they are packed, below.
epoch=${SOURCE_DATE_EPOCH:-}
case $epoch in '' | *[!0-9]*) epoch="" ;; esac
if [ -n "$epoch" ]; then
  for flag in --sort-name "--mtime=@$epoch"; do
    if accepts "$flag"; then
      tarflags="$tarflags $flag"
    fi
  done
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
host=$(go env GOHOSTOS)/$(go env GOHOSTARCH)

# Signs the darwin binary $2 of target $1 and has Apple notarize it.
notarize() {
  # --force replaces the ad hoc signature the Go linker gives an arm64
  # binary. The notary service asks for the hardened runtime and a secure
  # timestamp; the identifier is given because codesign would otherwise
  # derive it from the file's name.
  codesign --force --sign "$identity" --identifier dev.yardr.yardr \
    --options runtime --timestamp "$2"
  # The notary service takes a zip, a disk image or an installer package,
  # not a bare binary and not a tar.gz, so the zip is for the submission
  # only. zip and not ditto, which packs the extended attributes beside the
  # binary as a second member.
  zip -q -j "$2.zip" "$2"
  echo "$1: signed; waiting for Apple's notary service (minutes, as a rule)"
  # json, as the normal format is for reading: the id and the status are
  # taken from it. A refusal is a status, which notarytool need not exit
  # non-zero for.
  submit_exit=0
  if answer=$(xcrun notarytool submit "$2.zip" --keychain-profile "$profile" --wait --output-format json); then
    :
  else
    # Some notarytool versions can return a failed exit status along with a
    # completed submission result. Parse it below so a refusal still gets its
    # submission log instead of being reduced to a generic command failure.
    submit_exit=$?
  fi
  rm "$2.zip"
  field() {
    printf '%s\n' "$answer" | sed -n 's/.*"'"$1"'" *: *"\([^"]*\)".*/\1/p' | head -n 1
  }
  status=$(field status)
  id=$(field id)
  if [ "$submit_exit" -ne 0 ] || [ "$status" != Accepted ]; then
    echo "contrib/release/build: $1: Apple did not notarize the binary (status \"$status\", submission $id); its log:" >&2
    if [ -n "$id" ]; then
      xcrun notarytool log "$id" --keychain-profile "$profile" >&2 || true
    else
      echo "contrib/release/build: $1: notarytool submit failed (exit $submit_exit)" >&2
      printf '%s\n' "$answer" >&2
    fi
    exit 1
  fi
  echo "$1: notarized (submission $id)"
}

archives=""
for target in $targets; do
  os=${target%/*}
  arch=${target#*/}
  dir=$stage/${os}_$arch
  mkdir "$dir"
  # No cgo: the binary is static and needs no C toolchain for the target.
  # -trimpath keeps the builder's paths out of it.
  CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath \
    -ldflags "-s -w -X yardr.dev/yardr/internal/version.tag=$version" \
    -o "$dir/yardr" .

  # Go counts untracked files as modifications, so an out-dir inside the
  # checkout that git does not ignore makes every build after the first a
  # -modified one. A release is never cut from such a tree.
  if [ "${YARDR_RELEASE_ALLOW_DIRTY:-}" != 1 ] && go version -m "$dir/yardr" | grep -q 'vcs.modified=true'; then
    echo "contrib/release/build: $target was built from a tree with uncommitted or untracked files (git status); commit them, or set YARDR_RELEASE_ALLOW_DIRTY=1" >&2
    exit 1
  fi
  # The one binary this machine can run says what it was stamped with.
  if [ "$target" = "$host" ]; then
    got=$("$dir/yardr" version)
    case "$got" in
      "$version"|"$version ("*")") ;;
      *)
        echo "contrib/release/build: yardr version prints \"$got\"; want $version" >&2
        exit 1
        ;;
    esac
    echo "$target: yardr version: $got"
  fi

  # Before the archive is packed, so that it and its checksum are of the
  # binary Apple has seen. No ticket is stapled: a bare binary cannot carry
  # one, and Gatekeeper asks Apple for it at the first start.
  if [ "$os" = darwin ] && [ -n "$identity" ]; then
    notarize "$target" "$dir/yardr"
  fi

  # NOTICE goes with LICENSE: the FSL asks whoever passes the archive on
  # to keep the terms and the copyright notices with it.
  files="yardr README.md LICENSE NOTICE"
  cp README.md LICENSE NOTICE "$dir/"
  # The v is the tag's, not the version's: yardr_1.2.3_darwin_arm64.tar.gz.
  archive=yardr_${version#v}_${os}_$arch.tar.gz
  # A Mac does not always let the provenance attribute go, so this is on top
  # of the tar flags, not in their place.
  if command -v xattr >/dev/null 2>&1; then
    # shellcheck disable=SC2086 # $files is a list
    (cd "$dir" && xattr -c $files) 2>/dev/null || true
  fi
  if [ -n "$epoch" ]; then
    # One time on every staged file, for the tars that take no --mtime.
    # GNU date reads -d @<epoch>, a Mac's -r <epoch>.
    if stamp=$(date -u -d "@$epoch" +%Y%m%d%H%M.%S 2>/dev/null) ||
      stamp=$(date -u -r "$epoch" +%Y%m%d%H%M.%S 2>/dev/null); then
      # touch -t reads the stamp in local time; the stamp is UTC.
      # shellcheck disable=SC2086 # $files is a list
      (cd "$dir" && TZ=UTC touch -t "$stamp" $files)
    else
      echo "contrib/release/build: SOURCE_DATE_EPOCH is set and date formats neither -d @$epoch nor -r $epoch; unset it for archives stamped with the time" >&2
      exit 1
    fi
  fi
  # COPYFILE_DISABLE is what an older bsdtar without --no-mac-metadata reads.
  if [ -n "$epoch" ] && command -v gzip >/dev/null 2>&1; then
    # gzip -n writes no file name or timestamp; tar -z gives no such
    # control, so the tar is packed plain and compressed after. (A pipe
    # would hide tar's failure: sh has no pipefail.)
    # shellcheck disable=SC2086 # $files and $tarflags are lists
    COPYFILE_DISABLE=1 tar -cf "$stage/$archive.tar" $tarflags -C "$dir" $files
    gzip -n -c "$stage/$archive.tar" >"$out/$archive"
    rm -f "$stage/$archive.tar"
  else
    # shellcheck disable=SC2086 # $files and $tarflags are lists
    COPYFILE_DISABLE=1 tar -czf "$out/$archive" $tarflags -C "$dir" $files
  fi
  archives="$archives $archive"
done

# shellcheck disable=SC2086 # $archives and $sum are lists
(cd "$out" && $sum $archives >checksums.txt)
# A signature an earlier build left in the out-dir is of other checksums.
rm -f "$out/checksums.txt.minisig"
signature=""
if [ -n "$minisign_key" ]; then
  # minisign asks for the key's password on the terminal, or reads it from
  # standard input when that is none; a key made without one (-W) is not
  # asked about.
  if ! (cd "$out" && minisign -S -s "$minisign_key" -m checksums.txt); then
    # Checksums that were meant to be signed are not left looking like a
    # finished release.
    rm -f "$out/checksums.txt" "$out/checksums.txt.minisig"
    echo "contrib/release/build: minisign did not sign checksums.txt with $minisign_key" >&2
    exit 1
  fi
  signature=checksums.txt.minisig
  echo "checksums.txt: signed with minisign"
fi
echo "wrote to $out:"
# shellcheck disable=SC2086
(cd "$out" && ls -l $archives checksums.txt $signature)
