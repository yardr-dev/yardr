#!/bin/sh
# stage: the release flow's three scripted stages. Run it as the cmd of an
# exec group routed for build, verify and publish (one group with the stage
# in cmd: contrib/release/stage $YARDR_STAGE); docs/install.md "Making a
# release" says how a release is cut with the yard, and docs/setup.md how
# the yardmaster adds the group and the routes.
#
#   contrib/release/stage <build|verify|publish>
#
# It reads the bead from the environment the exec runner gives it (YARDR_BEAD,
# YARDR_DEPOT_PATH, YARDR_BASE, YARDR_BIN), like contrib/deploy/deploy-dokku,
# and the version from the bead's title's last word, which must be
# v<major>.<minor>.<patch>; the bead's body is the release notes.
#
#   build: refuses a bad title (question: the bead is wrong), a published
#     release, a tag at another commit, a dirty tree, and a checkout that
#     is not the remote's base; tags the base commit, pushes the tag, and
#     waits for the draft release CI's release workflow makes for the tag,
#     bounded; sets the draft's notes from the bead's body and notes the
#     five signing commands for the version on the bead. Then done, to
#     sign. A run that died after tagging resumes: a tag at the base
#     commit with no release on it is pushed again and waited on, and a
#     draft already standing is adopted, not refused. A CI run that
#     concluded anything but success reports failed with the run's URL.
#     When GitHub Actions is switched off on the release repo there is no
#     CI to wait for: build runs contrib/release/build on this machine
#     instead (SOURCE_DATE_EPOCH from the tagged commit, as the workflow
#     sets it) and makes the draft from it, with no attestation; a draft
#     already standing is adopted in both modes.
#   verify: downloads the release, checks checksums.txt.minisig against the
#     release key, the archives against checksums.txt, and each archive's
#     build-provenance attestation (gh attestation verify), skipped with
#     no attestation when Actions is off on the release repo. Then done, to
#     publish; a missing or bad signature reports failed with what minisign
#     said, so sign is asked again, and archives that do not match, an
#     attestation that does not verify, or a check that could not run,
#     report question, to decide.
#   publish: releases the draft, files the yardr.dev sync bead and advances
#     it to new, notes its id on the release bead. Then done, to published.
#
# Every failure path ends in a done with an outcome or a hold, never a bare
# exit, as deploy-dokku documents: has_outcome asks prime before moving, so
# only moves the flow allows are tried, and a flow that names none holds
# the bead instead.
#
# Needs on PATH: jq and git always; gh for build, verify and publish;
# minisign and shasum (or sha256sum) for verify. gh acts as whoever it is
# logged in as.
#
# Another depot's release flow calls this same script with its own release:
# the repo and the key come from the environment, with yardr's as the
# defaults. Its CI is expected to draft the release the same way
# (.github/workflows/release.yml does): the four archives and checksums.txt
# on the pushed tag, each archive attested. With Actions off on that repo
# too the draft is built on this machine instead, with no attestation.
#
#   YARDR_RELEASE_REPO      the GitHub repo, owner/name (default yardr-dev/yardr)
#   YARDR_RELEASE_PUBKEY    the minisign public key verify checks against
#                           (default yardr's release key)
#   YARDR_RELEASE_KEY_PATH  the signer's secret key, as the five commands
#                           name it (default ~/.minisign/<product>-release.key)
#   YARDR_RELEASE_REMOTE    the git remote the tag is fetched from and pushed
#                           to (default origin)
#   YARDR_RELEASE_WAIT_ROUNDS  how many times build asks after the draft
#                           (default 60)
#   YARDR_RELEASE_WAIT_SLEEP   seconds between those rounds (default 30)
set -u
# The ranges in the patterns below are ASCII's, and what git and gh say is
# read in English.
export LC_ALL=C
MODE=${1:-}
: "${YARDR_BEAD:?not run by an exec group}"
Y=${YARDR_BIN:-yardr}
BEAD=$YARDR_BEAD
REPO=${YARDR_DEPOT_PATH:-}
BASE=${YARDR_BASE:-}
GHREPO=${YARDR_RELEASE_REPO:-yardr-dev/yardr}
PRODUCT=${GHREPO##*/}
PUBKEY=${YARDR_RELEASE_PUBKEY:-RWSzUPGBbv7MDqH+nnbNmYdOm20UTkuk7eC5e6XuVtYRwZtaEZRlV/WB}
# The default keeps its ~ on every shell: quoted, it expands for whoever
# pastes the commands, not here (bash would expand an unquoted one, dash
# would not, and the note must read the same everywhere).
KEYPATH=${YARDR_RELEASE_KEY_PATH:-"~/.minisign/$PRODUCT-release.key"}
REMOTE=${YARDR_RELEASE_REMOTE:-origin}

# has_outcome <name>: whether the flow offers outcome <name> from here, asked
# of prime before moving, as merge-local asks (no jq: only sh, git and yardr
# are promised for the asking), so that only moves the flow allows are tried.
has_outcome() {
  "$Y" prime --bead "$BEAD" --json |
    sed -n '/^  "next": {/,/^  }/p' |
    sed -n '/^    "outcomes": \[/,/^    \]/p' |
    grep -q "^        \"name\": \"$1\""
}
# Each outcome is one move with its note. Moving ends this session (the
# daemon stops the script), so it is always the last thing done.
# done_with <stage> <note>: the flow's done outcome, else the stage by name.
done_with() {
  echo "== $BEAD: $2"
  if has_outcome "done"; then
    printf '%s\n' "$2" | "$Y" bead "done" "$BEAD" --note - && exit 0
  fi
  printf '%s\n' "$2" | "$Y" bead advance "$BEAD" --to "$1" --note -
  exit 0
}
hold() {
  echo "== hold $BEAD: $1"
  "$Y" bead note "$BEAD" "$MODE: $1"
  "$Y" bead hold "$BEAD"
  exit 0
}
# fail <outcome> <one line> [<more>]: the flow's outcome with the whole
# note; a flow that names none holds the bead instead.
fail() {
  outcome=$1
  text=$2
  if [ $# -gt 2 ]; then
    text="$text
$3"
  fi
  echo "== $BEAD $outcome: $2"
  if has_outcome "$outcome"; then
    printf '%s\n' "$MODE: $text" | "$Y" bead "done" "$BEAD" --outcome "$outcome" --note - && exit 0
  fi
  hold "$text"
}

case "$MODE" in
build | verify | publish) ;;
*)
  hold "run as the cmd of an exec group with the stage in it (contrib/release/stage \$YARDR_STAGE), not as '$*'"
  ;;
esac
# A dir depot has no tags and no base to build; a route that hands one over
# is a mistake in the depot's flow, as it is for merge-local.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  hold "depot ${YARDR_DEPOT:-?} is a dir depot, with no tags to release; route its stages to other groups"
fi
if ! command -v jq >/dev/null 2>&1; then
  fail failed "jq is not on PATH; the release group runs where jq, git and gh are"
fi

tmp=""
cleanup() {
  [ -z "$tmp" ] || rm -rf "$tmp"
}
trap cleanup EXIT
maketmp() {
  if ! tmp=$(mktemp -d "${TMPDIR:-/tmp}/release-stage.XXXXXX"); then
    tmp=""
    if [ "$MODE" = verify ]; then
      fail question "cannot make a working directory; nothing was checked"
    fi
    fail failed "cannot make a working directory; nothing was released"
  fi
}

# version <outcome>: the bead's title's last word in $v (and the bead's
# show --json in $show), refused unless v<major>.<minor>.<patch>. A bad one
# is a question about the bead itself, for a person to fix; a bead that
# cannot be read reports <outcome>.
version() {
  show=$("$Y" bead show "$BEAD" --json) || fail "$1" "reading the bead failed; nothing was released"
  title=$(printf '%s' "$show" | jq -r '.title // empty')
  title=$(printf '%s' "$title" | sed 's/ *$//')
  v=${title##* }
  # grep matches line by line, so a title with a newline in its last word
  # is refused here first: only the version, whole, reaches a tag, gh or
  # the signing commands.
  case $v in *[!v0-9.]*) v_ok="" ;; *) v_ok=1 ;; esac
  if [ -z "$v_ok" ] || ! printf '%s\n' "$v" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    fail question "the bead's title names no version (its last word is \"$v\"): title it \"$PRODUCT v<major>.<minor>.<patch>\" and advance the bead back to $MODE"
  fi
}

# actions_off: whether GitHub Actions is switched off on the release repo,
# asked of gh before build waits and before verify attests. Only a false
# answer counts: true, or an answer that cannot be read, is today's
# behaviour (wait for CI, check the attestations).
actions_off() {
  enabled=$(gh api "repos/$GHREPO/actions/permissions" --jq .enabled 2>/dev/null) || return 1
  [ "$enabled" = false ]
}

build() {
  : "${YARDR_DEPOT_PATH:?the bead has no depot}" "${YARDR_BASE:?the bead has no base}"
  command -v git >/dev/null 2>&1 || fail failed "git is not on PATH; the release group runs where jq, git and gh are"
  command -v gh >/dev/null 2>&1 || fail failed "gh is not on PATH (and logged in); the release group runs where jq, git and gh are"
  version failed
  echo "== $BEAD: build $v of $GHREPO from $BASE"
  # The body is the release notes; an empty one would make a release that
  # says nothing.
  body=$(printf '%s' "$show" | jq -r '.body // empty')
  [ -n "$body" ] || fail question "the bead has no body, which is the release notes: write them on it and advance the bead back to build"
  [ -z "$(git -C "$REPO" status --porcelain)" ] ||
    fail failed "$REPO has uncommitted or untracked files; commit or clean them, then advance the bead back to build"
  fetch_out=$(git -C "$REPO" fetch -q "$REMOTE" "$BASE" 2>&1) ||
    fail failed "fetching $REMOTE/$BASE in $REPO failed: $fetch_out. Nothing was tagged."
  base=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/$REMOTE/$BASE^{commit}") ||
    fail failed "$REMOTE/$BASE is not a branch $REPO knows after fetching; nothing was tagged"
  head=$(git -C "$REPO" rev-parse --verify -q 'HEAD^{commit}') ||
    fail failed "reading HEAD in $REPO failed; nothing was tagged"
  [ "$head" = "$base" ] ||
    fail failed "$REPO is at $(git -C "$REPO" rev-parse --short "$head"), not at $REMOTE/$BASE ($(git -C "$REPO" rev-parse --short "$base")): check out $BASE there and pull, then advance the bead back to build"
  at=$(git -C "$REPO" rev-parse --short "$base")
  # A run that died after tagging resumes: the tag is ours when it is at
  # this base, and tagging and pushing it again change nothing. A draft
  # already standing is a run that died while waiting, and is adopted,
  # not refused; anything published is.
  # No release standing reads as empty: gh fails, and jq passes empty
  # input through with success and no output.
  existing=$(gh release view "$v" --repo "$GHREPO" --json isDraft 2>/dev/null | jq -r .isDraft 2>/dev/null) || existing=""
  case $existing in
  "") ;;
  true) echo "== $BEAD: draft $v is already standing; adopting it" ;;
  false) fail failed "release $v already exists on $GHREPO, and is published: if a run left it half-made, fix it by hand and advance the bead to sign" ;;
  *) fail question "reading release $v failed; nothing was tagged" ;;
  esac
  tagat=$(git -C "$REPO" rev-parse --verify -q "refs/tags/$v^{commit}" 2>/dev/null || true)
  if [ -n "$tagat" ] && [ "$tagat" != "$base" ]; then
    fail failed "tag $v already exists in $REPO, at another commit ($(git -C "$REPO" rev-parse --short "$tagat")): delete it or title the bead for another version"
  fi
  maketmp
  [ -z "$tagat" ] || echo "== $BEAD: tag $v is already at $at; finishing that run"
  [ -n "$tagat" ] || git -C "$REPO" tag "$v" "$base" || fail failed "tagging $at as $v failed; nothing was pushed"
  git -C "$REPO" push "$REMOTE" "$v" >"$tmp/push.log" 2>&1 ||
    fail failed "tag $v is made but pushing it to $REMOTE failed; push it by hand, then advance the bead back to build" "$(tail -n 10 "$tmp/push.log")"
  # With Actions off on the release repo there is no CI to make the draft:
  # it is built on this machine instead, from this checkout at the pushed
  # tag, reproducibly (SOURCE_DATE_EPOCH from the tagged commit, as the
  # workflow sets it). A draft already standing is adopted here too,
  # filled again rather than refused.
  if actions_off; then
    echo "== $BEAD: Actions is off on $GHREPO; building $v on this machine"
    epoch=$(git -C "$REPO" log -1 --format=%ct "$base" 2>/dev/null) || epoch=""
    mkdir -p "$tmp/dist" ||
      fail failed "cannot make a working directory; nothing was released"
    if ! SOURCE_DATE_EPOCH="$epoch" "$REPO/contrib/release/build" "$v" "$tmp/dist" >"$tmp/build.log" 2>&1; then
      fail failed "building $v on this machine failed; fix the failure, delete the tag here and on $REMOTE, and advance the bead back to build" "$(tail -n 20 "$tmp/build.log")"
    fi
    n_dist=0
    for f in "$tmp/dist"/*.tar.gz; do
      [ -f "$f" ] || continue
      n_dist=$((n_dist + 1))
    done
    missing=""
    for target in darwin_amd64 darwin_arm64 linux_amd64 linux_arm64; do
      archive="yardr_${v#v}_$target.tar.gz"
      [ -f "$tmp/dist/$archive" ] || missing="$missing $archive"
    done
    if [ "$n_dist" -ne 4 ] || [ -n "$missing" ] || [ ! -f "$tmp/dist/checksums.txt" ]; then
      fail failed "the build on this machine did not make the four expected archives and checksums.txt (found $n_dist archives; missing:$missing); fix the failure, delete the tag here and on $REMOTE, and advance the bead back to build" "$(tail -n 20 "$tmp/build.log")"
    fi
    printf '%s\n' "$body" >"$tmp/notes.md"
    if [ "$existing" = true ]; then
      gh release upload "$v" --repo "$GHREPO" "$tmp/dist"/*.tar.gz "$tmp/dist/checksums.txt" --clobber >"$tmp/upload.log" 2>&1 ||
        fail failed "uploading this machine's build to the standing draft for $v failed; build again by hand (contrib/release/build $v dist) and upload it, then advance the bead to sign" "$(cat "$tmp/upload.log")"
      if gh release edit "$v" --repo "$GHREPO" --notes-file "$tmp/notes.md" >"$tmp/notes.log" 2>&1; then
        echo "== $BEAD: the draft's notes are the bead's body"
      else
        fail failed "the draft for $v holds this machine's build but setting its notes from the bead failed; set them by hand from the bead's body, then advance the bead to sign" "$(cat "$tmp/notes.log")"
      fi
    else
      if gh release create "$v" --repo "$GHREPO" --draft --verify-tag --notes-file "$tmp/notes.md" "$tmp/dist"/*.tar.gz "$tmp/dist/checksums.txt" >"$tmp/create.log" 2>&1; then
        echo "== $BEAD: draft $v holds this machine's build"
      else
        fail failed "the build for $v is made but creating its draft failed; build again by hand (contrib/release/build $v dist) and make the draft from it, then advance the bead to sign" "$(cat "$tmp/create.log")"
      fi
    fi
    built_by="built on this machine from $at, with no attestation"
    run_line=""
  else
    # The pushed tag starts CI's release workflow, which tests, builds the
    # archives and checksums.txt, attests them and makes the draft. Each
    # round asks the workflow for its run and the release for its assets;
    # the draft is done when it holds the four archives and checksums.txt.
    # A gh answer that cannot be read is another round, not a failure: only
    # a run that concluded, or the last round, ends the wait.
    rounds=${YARDR_RELEASE_WAIT_ROUNDS:-60}
    sleep_for=${YARDR_RELEASE_WAIT_SLEEP:-30}
    case $rounds in '' | *[!0-9]*) rounds=60 ;; esac
    case $sleep_for in '' | *[!0-9]*) sleep_for=30 ;; esac
    run_url=""
    n_arch=0
    has_sums=0
    i=0
    while [ "$i" -lt "$rounds" ]; do
      i=$((i + 1))
      runs=$(gh run list --repo "$GHREPO" --workflow release.yml --commit "$base" --event push --json conclusion,status,url --limit 1 2>/dev/null) || runs=""
      if [ -n "$runs" ]; then
        status=$(printf '%s' "$runs" | jq -r '.[0].status // empty' 2>/dev/null) || status=""
        concl=$(printf '%s' "$runs" | jq -r '.[0].conclusion // empty' 2>/dev/null) || concl=""
        url=$(printf '%s' "$runs" | jq -r '.[0].url // empty' 2>/dev/null) || url=""
        [ -z "$url" ] || run_url=$url
        if [ "$status" = completed ] && [ -n "$concl" ] && [ "$concl" != success ]; then
          fail failed "CI's release run for $v $concl ($run_url): fix the failure, delete the tag here and on $REMOTE, and advance the bead back to build"
        fi
      fi
      draft=$(gh release view "$v" --repo "$GHREPO" --json assets 2>/dev/null) || draft=""
      if [ -n "$draft" ]; then
        n_arch=$(printf '%s' "$draft" | jq '[.assets[]?.name | select(endswith(".tar.gz"))] | length' 2>/dev/null) || n_arch=0
        has_sums=$(printf '%s' "$draft" | jq '[.assets[]?.name | select(. == "checksums.txt")] | length' 2>/dev/null) || has_sums=0
      fi
      if [ "$n_arch" -eq 4 ] && [ "$has_sums" -ge 1 ]; then
        echo "== $BEAD: draft $v holds the four archives and checksums.txt"
        break
      fi
      [ "$i" -ge "$rounds" ] || sleep "$sleep_for"
    done
    if [ "$n_arch" -ne 4 ] || [ "$has_sums" -lt 1 ]; then
      mins=$((rounds * sleep_for / 60))
      where="no release run has shown for the tag yet"
      [ -z "$run_url" ] || where="the run is at $run_url"
      fail failed "CI did not finish the draft for $v in $mins minutes ($where); check the run, and to run it again delete the tag here and on $REMOTE and advance the bead back to build"
    fi
    printf '%s\n' "$body" >"$tmp/notes.md"
    if gh release edit "$v" --repo "$GHREPO" --notes-file "$tmp/notes.md" >"$tmp/notes.log" 2>&1; then
      echo "== $BEAD: the draft's notes are the bead's body"
    else
      fail failed "the draft for $v is complete but setting its notes from the bead failed; set them by hand from the bead's body, then advance the bead to sign" "$(cat "$tmp/notes.log")"
    fi
    built_by="built by CI from $at"
    run_line=""
    [ -z "$run_url" ] || run_line=" CI's run is at $run_url."
  fi
  url="https://github.com/$GHREPO/releases/tag/$v"
  # A literal ~ for the note below: mckean pastes those commands into a
  # shell of their own, where the tilde expands to their home, not this one's.
  # shellcheck disable=SC2088
  dir="~/releases/$v"
  done_with sign "build: $PRODUCT $v is drafted ($url, $built_by): the four archives and checksums.txt, the checksums not yet signed.$run_line Sign them with the five commands, in order (minisign asks for the key's password; each names $v):

mkdir -p $dir
gh release download $v --repo $GHREPO --pattern checksums.txt --dir $dir --clobber
minisign -S -s $KEYPATH -m $dir/checksums.txt
minisign -V -P $PUBKEY -m $dir/checksums.txt
gh release upload $v --repo $GHREPO $dir/checksums.txt.minisig --clobber

Then Done: the verify stage checks the signature next."
}

verify() {
  command -v gh >/dev/null 2>&1 || fail question "gh is not on PATH (and logged in); the release group runs where jq, gh and minisign are"
  command -v minisign >/dev/null 2>&1 || fail question "minisign is not on PATH; the release group runs where jq, gh and minisign are"
  if command -v shasum >/dev/null 2>&1; then
    sum="shasum -a 256"
  elif command -v sha256sum >/dev/null 2>&1; then
    sum="sha256sum"
  else
    fail question "neither shasum nor sha256sum is on PATH; the release group runs where one of them is"
  fi
  version question
  echo "== $BEAD: verify $v of $GHREPO"
  maketmp
  gh release download "$v" --repo "$GHREPO" --dir "$tmp" >"$tmp/download.log" 2>&1 ||
    fail question "downloading release $v failed; nothing was checked" "$(cat "$tmp/download.log")"
  [ -f "$tmp/checksums.txt" ] || fail question "release $v holds no checksums.txt; it is remade by hand (the release and the tag deleted, the bead back to build)"
  [ -f "$tmp/checksums.txt.minisig" ] ||
    fail failed "checksums.txt.minisig is not on release $v yet: run the five commands in the build's note, then Done again"
  # The signature covers the checksums, and the checksums cover each
  # archive; both are checked, in that order.
  minisign_out=$(minisign -V -P "$PUBKEY" -m "$tmp/checksums.txt" 2>&1) ||
    fail failed "the signature on release $v is bad" "$minisign_out"
  # shellcheck disable=SC2086 # $sum is a list
  (cd "$tmp" && $sum -c checksums.txt >check.log 2>&1) ||
    fail question "the archives of release $v do not match its checksums.txt; it is remade by hand (the release and the tag deleted, the bead back to build)" "$(cat "$tmp/check.log")"
  names=$(sed -n 's/^[0-9a-fA-F][0-9a-fA-F]*  *[* ]\{0,1\}\(.*\)$/\1/p' "$tmp/checksums.txt")
  n=$(printf '%s\n' "$names" | grep -c .) || n=0
  [ "$n" -gt 0 ] || fail question "release $v's checksums.txt names no files; it is remade by hand (the release and the tag deleted, the bead back to build)"
  # And nothing rides along that the checksums do not cover.
  extra=""
  for f in "$tmp"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    case $b in
    checksums.txt | checksums.txt.minisig | download.log | check.log) continue ;;
    esac
    printf '%s\n' "$names" | grep -q -x -F "$b" || extra="$extra $b"
  done
  [ -z "$extra" ] ||
    fail question "release $v holds files its checksums.txt does not name ($extra); it is remade by hand (the release and the tag deleted, the bead back to build)"
  # With Actions off the release was built on this machine, with no
  # attestation to check; the signature and the checksums are the whole
  # of it.
  if actions_off; then
    echo "== $BEAD: Actions is off on $GHREPO; skipping attestations"
    done_with publish "verify: the signature on $v is good ($minisign_out), its $n archives match checksums.txt (no attestation: built on this machine)."
  fi
  # Each file's attestation says CI's release workflow built it; without
  # one the files are not the workflow's, however well they checksum.
  # shellcheck disable=SC2086 # $names is a newline-separated list
  for b in $names; do
    attest_out=$(gh attestation verify "$tmp/$b" --repo "$GHREPO" \
      --signer-workflow "$GHREPO/.github/workflows/release.yml" \
      --source-ref "refs/tags/$v" 2>&1) ||
      fail question "the attestation for $b on release $v is missing or bad: the files are not CI's build, or the check could not reach GitHub. It is remade by hand (the release and the tag deleted, the bead back to build), or checked again where the failure was the network" "$attest_out"
  done
  done_with publish "verify: the signature on $v is good ($minisign_out), its $n archives match checksums.txt, and every archive's attestation verifies."
}

publish() {
  : "${YARDR_DEPOT_PATH:?the bead has no depot}"
  command -v git >/dev/null 2>&1 || fail failed "git is not on PATH; the release group runs where jq, git and gh are"
  command -v gh >/dev/null 2>&1 || fail failed "gh is not on PATH (and logged in); the release group runs where jq, git and gh are"
  version failed
  echo "== $BEAD: publish $v of $GHREPO"
  maketmp
  at=$(git -C "$REPO" rev-parse --short --verify -q "refs/tags/$v^{commit}" 2>/dev/null) ||
    fail failed "tag $v is not in $REPO; fetch it, then advance the bead back to publish"
  gh release edit "$v" --repo "$GHREPO" --draft=false >"$tmp/draft.log" 2>&1 ||
    fail failed "releasing the draft for $v failed; release it by hand (gh release edit $v --repo $GHREPO --draft=false), then advance the bead back to publish" "$(cat "$tmp/draft.log")"
  url="https://github.com/$GHREPO/releases/tag/$v"
  day=$(date +%Y-%m-%d)
  if [ "$PRODUCT" = yardr ]; then other=footplate; else other=yardr; fi
  title="Sync $PRODUCT $v to yardr.dev: scripts/sync-release $PRODUCT $v"
  body="$PRODUCT $v is released ($url, built from $at) and its checksums.txt.minisig is uploaded and verified against the release key on $day.

Run, from the depot's checkout: \`scripts/sync-release $PRODUCT $v\` (fetches the release with gh from $GHREPO, verifies the signature and the four archives, replaces the previous $PRODUCT release directory with $v/ and rewrites public/releases/latest.json). Commit what it wrote. Nothing else changes.

Done when: the depot's test command passes; \`git diff main --stat\` shows only public/releases/ (the $PRODUCT paths, not $other's). After the deploy, https://yardr.dev/releases/latest.json names $v and the page offers it."
  new=$(printf '%s' "$body" | "$Y" bead create "$title" -d yardr.dev -p 1 -b - -l difficulty:1,size:small --json 2>"$tmp/create.err" | jq -r '.id // empty') || new=""
  [ -n "$new" ] || fail failed "filing the sync bead failed" "$(cat "$tmp/create.err")"
  "$Y" bead advance "$new" --to new || fail failed "sync bead $new is filed but advancing it to new failed; advance it by hand, then this bead to published"
  "$Y" bead note "$BEAD" "publish: filed $new (\"$title\") and advanced it to new."
  done_with published "publish: $PRODUCT $v is released from its draft; $new carries the site's sync."
}

case "$MODE" in
build) build ;;
verify) verify ;;
publish) publish ;;
esac
