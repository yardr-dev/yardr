#!/bin/sh
# pr-train: brings an approved train's pull request up to date, so what is
# merged is what was reviewed. Run it as the cmd of an exec group (yard-pr,
# limit 1) routed for the train flow's approved stage (type train), when
# trains land through pull requests (integrate-train with YARDR_PR=1). See
# docs/line.md, section Trains.
#
# The pull-request path is experimental and off by default: without
# YARDR_PR in the group's cmd, as for integrate-train, the train is held with
# a note and nothing is pushed or asked of GitHub.
#
# It reads the environment the exec runner gives it, as integrate-train
# does: YARDR_BEAD (the train), YARDR_DEPOT_PATH, YARDR_BASE, YARDR_BRANCH,
# YARDR_WORKTREE and YARDR_BIN. Options, set in the group's cmd:
#
#   YARDR_PR       1: the switch for the pull-request path; held without it
#   YARDR_PUSH     the remote the pull request's branch is on (default origin)
#
# It pushes yard/<train>, which may have gained the reviewer's commits, and
# replaces the PR's body with the train's, its children, the first review's
# note under "Review", the security review's under "Security review" where it
# has one, and the trailer "Train: <id>", stores the commit it pushed as the
# train's pr_reviewed_sha (the only head pr-merge will merge), then reports
# done (-> in-pr). A push the remote refuses, a remote branch with commits the
# train lacks, a PR GitHub finds conflicting with the base, or no PR bound
# to the train reports failed (-> open): the integrator rebases and opens it
# again. A branch it cannot work on (missing, dirty) is held, as is a train
# whose pull request is not the one it is bound to (another number, head
# repository or branch). Needs gh, logged in as the operator, and jq on PATH.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
# A dir depot (YARDR_DEPOT_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the depot's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  echo "pr-train: depot ${YARDR_DEPOT:-?} is a dir depot, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_DEPOT_PATH:?bead has no depot}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
TRAIN=$YARDR_BEAD
REPO=$YARDR_DEPOT_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$TRAIN}
WT=${YARDR_WORKTREE:-}
PUSH=${YARDR_PUSH:-origin}
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') pr $TRAIN ($BR)"

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done.
hold() { echo "== hold $TRAIN: $1"; "$Y" bead note "$TRAIN" "pr: $1"; "$Y" bead hold "$TRAIN"; exit 0; }
report() {
  echo "== $TRAIN $1"
  printf '%s\n' "pr: $2" | "$Y" bead done "$TRAIN" --outcome "$1" --note - && exit 0
  hold "could not report $1 (does the train's flow name it for its stage?): $2"
}
errf=$(mktemp) && trap 'rm -f "$errf"' EXIT

# Off unless switched on: a route that hands a train here by accident must
# not push or touch a pull request. Held, not failed: failed would send the
# train round through open and back here.
[ -n "${YARDR_PR:-}" ] ||
  hold "the pull-request path is experimental and off: YARDR_PR is not set in this group's cmd. Route approved for trains to the assembly (merge-local lands the train locally), or set YARDR_PR=1 in the cmd of every group on the path, then unhold."

git -C "$REPO" rev-parse --verify -q "refs/heads/$BR" >/dev/null || hold "branch $BR does not exist"
if [ -n "$WT" ] && [ -d "$WT" ]; then
  [ -z "$(git -C "$WT" status --porcelain)" ] ||
    hold "worktree $WT has uncommitted changes; commit them on $BR (or drop them), then unhold"
fi
prbase=$BASE
remote=${BASE%%/*}
[ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote" && prbase=${BASE#*/}

train=$("$Y" prime --bead "$TRAIN" --json) || hold "reading $TRAIN failed"
# The train's pull request is the one integrate-train bound it to, by number
# and head repository, never one looked up by the branch's name: a fork's
# pull request can carry the same name. What GitHub says of it must match
# the binding, or it is not the train's to push for.
url=$(printf '%s' "$train" | jq -r '.bead.metadata.pr_url // empty')
num=$(printf '%s' "$train" | jq -r '.bead.metadata.pr_number // empty')
headrepo=$(printf '%s' "$train" | jq -r '.bead.metadata.pr_head_repo // empty')
[ -n "$url" ] && [ -n "$num" ] && [ -n "$headrepo" ] ||
  report failed "no pull request bound to $TRAIN (pr_url, pr_number, pr_head_repo): integrating the train again opens one, or binds the one in pr_url"
pr=$(cd "$REPO" && gh pr view "$url" --json number,state,headRefName,headRepositoryOwner,headRepository 2>"$errf") ||
  report failed "reading pull request $url failed: $(cat "$errf")"
is="#$(printf '%s' "$pr" | jq -r .number) from $(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end'):$(printf '%s' "$pr" | jq -r .headRefName)"
[ "$is" = "#$num from $headrepo:$BR" ] ||
  hold "pull request $url is $is, but $TRAIN is bound to #$num from $headrepo:$BR. Not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
[ "$(printf '%s' "$pr" | jq -r '.state // empty')" = OPEN ] ||
  report failed "pull request $url is not open; integrating the train again opens a new one"

# The push carries what the reviewer committed on the branch. The lease is
# what the remote has now, and only when all of it is in the branch: a
# remote branch with commits of its own is not overwritten.
theirs=$(git -C "$REPO" ls-remote "$PUSH" "refs/heads/$BR" 2>"$errf") ||
  report failed "reading $PUSH/$BR failed: $(cat "$errf")"
theirs=$(printf '%s' "$theirs" | cut -f1)
if [ -n "$theirs" ] && ! git -C "$REPO" merge-base --is-ancestor "$theirs" "$BR" 2>/dev/null; then
  report failed "$PUSH/$BR has commits $BR lacks; not forced. Bring them into $BR (or drop them on $PUSH); the integrator rebases it again."
fi
# Pushed by its sha, read once: the commit stored below as reviewed is the
# one the remote got, even if the branch moves while this runs.
reviewed=$(git -C "$REPO" rev-parse --verify -q "refs/heads/$BR^{commit}") || hold "branch $BR does not resolve"
out=$(git -C "$REPO" push --force-with-lease="refs/heads/$BR:$theirs" "$PUSH" "$reviewed:refs/heads/$BR" 2>&1) ||
  report failed "pushing $BR to $PUSH failed: $out"
sha=$(git -C "$REPO" rev-parse --short "$reviewed")

# GitHub's view of whether the PR merges: CONFLICTING means the base moved
# under it, which the integrator's rebase resolves or holds for a human.
mergeable=$(cd "$REPO" && gh pr view "$url" --json mergeable --jq .mergeable 2>"$errf") ||
  report failed "reading pull request $url failed: $(cat "$errf")"
[ "$mergeable" != CONFLICTING ] ||
  report failed "pull request $url conflicts with $prbase; the integrator rebases $BR again"

# The body as integrate-train writes it, with the reviews before the
# trailer. The reviews' notes are the last two no script wrote: the first
# review's, then the security review's where it has one.
noted=$(printf '%s' "$train" |
  jq -r '[.notes[]? | select(.text | test("^(integrator|assembly|pr): ") | not) | .text]')
review=$(printf '%s' "$noted" | jq -r 'if length == 1 then .[0] elif length > 1 then .[-2] else empty end')
security=$(printf '%s' "$noted" | jq -r 'if length > 1 then .[-1] else empty end')
body=$(
  printf '%s' "$train" | jq -r '.bead.body // ""'
  printf '\n## Children\n\n'
  for c in $(printf '%s' "$train" | jq -r '.family.children[]?'); do
    printf -- '- %s %s\n' "$c" "$("$Y" bead show "$c" --json | jq -r .title)"
  done
  [ -z "$review" ] || printf '\n## Review\n\n%s\n' "$review"
  [ -z "$security" ] || printf '\n## Security review\n\n%s\n' "$security"
  printf '\nTrain: %s\n' "$TRAIN"
)
out=$(cd "$REPO" && printf '%s\n' "$body" | gh pr edit "$url" --body-file - 2>&1) ||
  report failed "updating pull request $url failed: $out"

# The reviewed commit, beside the binding: what the reviewer approved, with
# their own commits, and the only head pr-merge merges. Stored last, so a
# train never enters in-pr with the sha of an earlier round. Quoted, as
# --meta reads JSON: a sha of digits alone would be stored as a number.
"$Y" bead update "$TRAIN" --meta "pr_reviewed_sha=\"$reviewed\"" >/dev/null ||
  report failed "pushed $BR at $sha to $PUSH, but storing it as the reviewed commit (pr_reviewed_sha) failed."

report done "pushed $BR at $sha to $PUSH; pull request $url is up to date with the review. Reviewed commit (pr_reviewed_sha): $reviewed."
