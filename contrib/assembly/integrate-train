#!/bin/sh
# integrate-train: brings a train's branch up to date with its depot's base
# and tests it, once its last child has landed on it, so the train goes to
# review as exactly what would land. Run it as the cmd of an exec group
# routed for the train flow's open stage (type train); limit 1 on the group
# integrates one train at a time. See docs/line.md, section Trains.
#
# It reads everything from the environment the exec runner gives it, as
# merge-local does: YARDR_BEAD (the train), YARDR_DEPOT, YARDR_DEPOT_PATH,
# YARDR_BASE (the depot's base), YARDR_BRANCH (yard/<train>), YARDR_WORKTREE,
# YARDR_BIN and YARDR_TEST, the depot's test command (yardr depot add
# --test), unset for a depot with none. Options, set in the group's cmd:
#
#   YARDR_PUSH          a remote to push the train branch to; off when empty
#   YARDR_NOTIFY        crew member mailed when that push fails (default: the
#                       yard's yardmaster setting, else yardmaster)
#   YARDR_PR            1: open a pull request for the pushed branch against
#                       the base, or update the one the train is bound to,
#                       and bind the train to it (pr_url, pr_number,
#                       pr_head_repo in its metadata); needs YARDR_PUSH, and
#                       gh and jq on PATH, gh logged in as the operator
#   YARDR_TEST_TIMEOUT  seconds the test command may run (default 1800)
#
# It fetches the base when it is a remote's, rebases the train branch onto
# the base, runs the depot's test command on the result, with
# YARDR_LANDING=1, and reports done (-> review). A red run reports failed
# (-> open) with the commit and the end of the output, after adding a child
# to fix it, which carries the same: the child blocks the train, so it is
# not integrated again until the fix has landed on its branch. A rebase that
# conflicts reports conflict (-> merge), as merge-local does for a bead: the
# mergers rebase the branch and send the train back to open, where it is
# integrated again. A test command that says it could not run (exit 2), or a
# branch it cannot work on, is held for a human; a run ended by a signal is
# run once more, and held if one ends it again. A depot with no test command
# goes to review untested, and the note says so.
#
# Every outcome ends in a report or a hold: exiting without one counts as a
# failed session, and three of those hold the bead.
set -u
# A dir depot (YARDR_DEPOT_KIND=dir) has no branches: there is nothing here to
# land, integrate or open a pull request for. A route that hands one over is
# a mistake in the depot's flow, so refuse to run (exit 2) rather than guess.
if [ "${YARDR_DEPOT_KIND:-git}" = dir ]; then
  echo "integrate-train: depot ${YARDR_DEPOT:-?} is a dir depot, with no branch to work on; route its stages to other groups" >&2
  exit 2
fi
: "${YARDR_BEAD:?not run by an exec group}" "${YARDR_DEPOT:?bead has no depot}"
: "${YARDR_DEPOT_PATH:?}" "${YARDR_BASE:?}"
Y=${YARDR_BIN:-yardr}
TRAIN=$YARDR_BEAD
DEPOT=$YARDR_DEPOT
REPO=$YARDR_DEPOT_PATH
BASE=$YARDR_BASE
BR=${YARDR_BRANCH:-yard/$TRAIN}
WT=${YARDR_WORKTREE:-${YARDR_HOME:-$HOME/.yardr}/worktrees/$DEPOT/$TRAIN}
PUSH=${YARDR_PUSH:-}
NOTIFY=${YARDR_NOTIFY:-}
PR=${YARDR_PR:-}
TAIL=200
echo "== $(date '+%Y-%m-%dT%H:%M:%S%z') integrate $DEPOT $TRAIN ($BR onto $BASE)"

# Reporting ends this session (the daemon stops the script), so it is
# always the last thing done.
hold() { echo "== hold $TRAIN: $1"; "$Y" bead note "$TRAIN" "integrator: $1"; "$Y" bead hold "$TRAIN"; exit 0; }
report() {
  echo "== $TRAIN $1"
  printf '%s\n' "integrator: $2" | "$Y" bead done "$TRAIN" --outcome "$1" --note - && exit 0
  hold "could not report $1 (does the train's flow name it for its stage?): $2"
}

[ -z "$PR" ] || [ -n "$PUSH" ] ||
  hold "YARDR_PR is set without YARDR_PUSH: a pull request needs the branch on a remote. Set both in the group's cmd, then unhold."
git -C "$REPO" rev-parse --verify -q "refs/heads/$BR" >/dev/null ||
  hold "branch $BR does not exist: no child has landed on it yet. Add children (yardr dep add $TRAIN <child> -k parent), then unhold."

# Fetch the base when it is a remote's (origin/main), as the herdr runner
# does before a bead branches from it; a fetch that fails or hangs leaves the
# base as it is. A local base is what the assembly lands on: nothing to fetch.
remote=${BASE%%/*}
if [ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote"; then
  to=; command -v timeout >/dev/null && to="timeout 60"
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true $to git -C "$REPO" fetch --quiet "$remote" ||
    echo "== fetching $remote failed; integrating onto $BASE as it is"
fi
git -C "$REPO" rev-parse --verify -q "$BASE^{commit}" >/dev/null || hold "base $BASE does not resolve in $REPO"
# The branch a pull request targets: the base without its remote.
prbase=$BASE
[ "$remote" != "$BASE" ] && git -C "$REPO" remote | grep -qx "$remote" && prbase=${BASE#*/}

if [ ! -d "$WT" ]; then
  git -C "$REPO" worktree add "$WT" "$BR" || hold "cannot check out $BR at $WT"
fi
[ "$(git -C "$WT" symbolic-ref -q HEAD)" = "refs/heads/$BR" ] || hold "$WT is not on $BR"
[ -z "$(git -C "$WT" status --porcelain)" ] || hold "worktree $WT has uncommitted changes"
[ -n "$(git -C "$REPO" rev-list -n 1 "$BASE..$BR")" ] ||
  hold "$BR has nothing $BASE lacks: no child's work to land"

# Rebase onto the base when it moved since the train branched. A conflict
# here is between the train as a whole and main, which no single child owns:
# it goes to the mergers like any other, who rebase the branch in its
# worktree and report done (-> open), so the integrator tests it again.
was=$(git -C "$REPO" rev-parse "$BR")
if ! git -C "$REPO" merge-base --is-ancestor "$BASE" "$BR"; then
  if ! git -C "$WT" rebase "$BASE"; then
    files=$(git -C "$WT" diff --name-only --diff-filter=U | tr '\n' ' ')
    git -C "$WT" rebase --abort
    report conflict "rebase of $BR onto $BASE conflicts in: $files
$BR is at $(git -C "$REPO" rev-parse --short "$BR"), $BASE at $(git -C "$REPO" rev-parse --short "$BASE").
Rebase $BR onto $BASE in $WT keeping both sides' intent, and do not push it: back in open, the integrator tests and pushes it. The tip you start from is old tip: $(git -C "$REPO" rev-parse "$BR"); note it too, as a merger's note does: the push replaces $PUSH/$BR only when everything there is in a tip noted this way."
  fi
fi

# The depot's test command runs on exactly what goes to review and then
# lands, as merge-local runs it for a bead and with YARDR_LANDING=1: the
# train is what moves the depot's base. Where the command is the path of a
# file the base has, the base's copy of that file is what runs, with sh, in
# the train's worktree; anything else is a command for sh -c. With no test
# command the train goes to review untested.
#
# Exit 2 is the command saying it could not run at all, which no child can
# fix. An exit above 128 means the run was ended by a signal from outside,
# which says nothing about the branch and which no child can fix either: as
# in merge-local, it is run once more, after a note with the first run's
# tail, and ended by a signal twice the train is held. The kill at the
# deadline is not this: it is a red run.
TEST=${YARDR_TEST:-}
LIMIT=${YARDR_TEST_TIMEOUT:-1800}
# tree prints a process and everything below it, in one order every time.
tree() {
  ps -A -o pid= -o ppid= | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      below[root] = 1
      do { more = 0; for (p in parent) if (!(p in below) && (parent[p] in below)) { below[p] = 1; more = 1 } } while (more)
      for (p in below) print p
    }' | sort -n
}
# unwatched kills the timeout watcher and its sleep, after a run and on
# every exit while one is in flight (the traps): a watcher left behind
# sleeps out its $LIMIT holding the run's inherited files, among them once
# the machine race lock (yardr-tsms). The sleep goes by the pid the watcher
# wrote, in case the watcher died without killing it, and both kills are
# silent: either may already be gone.
unwatched() {
  [ -n "${watch:-}" ] || return 0
  kill "$watch" 2>/dev/null
  if [ -n "${log:-}" ] && [ -f "$log.nap" ]; then kill "$(cat "$log.nap")" 2>/dev/null; fi
  wait "$watch" 2>/dev/null
  watch=
}
trap 'unwatched' EXIT
# A signal that kills the script does not run its EXIT trap, so TERM and
# INT clean up first and then report as a shell would, 128+n.
trap 'unwatched; exit 143' TERM
trap 'unwatched; exit 130' INT
# runtest runs the test command in the worktree and leaves its exit status in
# $rc, the last $TAIL lines of its output in $out, how many lines there were
# in $lines, and $late set when it ran past $LIMIT seconds. The bound is
# sh's own, as in merge-local, which says why it is made this way.
runtest() {
  log=$(mktemp "${TMPDIR:-/tmp}/integrate-train.XXXXXX") || hold "cannot make a file for the tests' output"
  copy=
  if [ "$WHAT" = "the base's copy of $TEST" ]; then
    copy=$log.sh
    git -C "$REPO" show "$BASE:$TEST" >"$copy" || { rm -f "$log" "$copy"; hold "cannot read $TEST from $BASE"; }
  fi
  (
    cd "$WT" || exit 2
    export YARDR_LANDING=1
    if [ -n "$copy" ]; then exec sh "$copy"; else exec sh -c "$TEST"; fi
  ) >"$log" 2>&1 </dev/null &
  pid=$!
  (
    nap=
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    # The sleep holds none of the run's inherited files: close every open
    # fd above 2 first (an orphaned sleep once held the machine race lock).
    # Enumerate /dev/fd so this covers high descriptors too. The loop has no
    # redirection: the shell saves fd 2 above 10 for one, and would close the
    # save from under itself; each path is one open fd name.
    for path in /dev/fd/*; do
      fd=${path##*/}
      case "$fd" in ''|*[!0-9]*|[012]) continue ;; esac
      eval "exec $fd>&-"
    done
    sleep "$LIMIT" &
    nap=$!
    echo "$nap" >"$log.nap"
    wait "$nap"
    : >"$log.late"
    seen=
    while t=$(tree "$pid") && [ "$t" != "$seen" ]; do
      # shellcheck disable=SC2086
      kill -STOP $t 2>/dev/null
      seen=$t
    done
    # Whatever ps said, the command itself goes.
    # shellcheck disable=SC2086
    kill -KILL ${seen:-$pid} 2>/dev/null
  ) &
  watch=$!
  # The watcher records its sleep before it waits on it; hold until it has
  # (a bounded wait), so the cleanup never kills a watcher whose sleep is
  # not yet known.
  i=0
  while [ ! -f "$log.nap" ] && [ "$i" -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
  wait "$pid" && rc=0 || rc=$?
  unwatched
  # A command that passed as its deadline came has passed.
  late=
  if [ -e "$log.late" ] && [ "$rc" != 0 ]; then
    late=1
    echo "integrate-train: the tests ran past their deadline of ${LIMIT}s and were killed" >>"$log"
  fi
  lines=$(wc -l <"$log" | tr -d ' ')
  out=$(tail -n "$TAIL" "$log")
  rm -f "$log" "$log.late" "$log.nap" "$log.sh"
  printf '%s\n' "$out"
}
# What a note says of a run's output: all of it, or its end.
shown() {
  if [ "$lines" -gt "$TAIL" ]; then echo "the last $TAIL of $lines lines of output"; else echo "its output"; fi
}
tested=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
at=$(git -C "$REPO" rev-parse --short "$tested")
if [ -z "$TEST" ]; then
  echo "== depot $DEPOT has no test command: $TRAIN goes to review untested"
  ran="untested: no test command on the depot"
else
  if [ "$(git -C "$REPO" cat-file -t "$BASE:$TEST" 2>/dev/null)" = blob ]; then
    WHAT="the base's copy of $TEST"
  else
    WHAT="the command $TEST"
  fi
  echo "== the tests on $BR at $at: $WHAT, with YARDR_LANDING=1"
  runtest
  if [ "$rc" -gt 128 ] && [ -z "$late" ]; then
    now=$(git -C "$REPO" rev-parse "refs/heads/$BR") || hold "cannot read $BR"
    [ "$now" = "$tested" ] || hold "$BR moved while the tests ran: tested $at, now $(git -C "$REPO" rev-parse --short "$now"). Cannot retry on the same commit."
    first="the tests on $BR at $at ($WHAT) were ended by signal $((rc - 128)) (exit $rc), not by a failing test"
    echo "== $first; running them once more"
    "$Y" bead note "$TRAIN" "integrator: $first; running them once more on the same commit. Of the first run, $(shown):
$out" || echo "== could not note the first run on $TRAIN"
    out1=$out
    runtest
    [ "$rc" -le 128 ] || [ -n "$late" ] || hold "$first, and again by signal $((rc - 128)) (exit $rc) when run once more. The branch is not at fault: find what sends the signal, then unhold to test it again.
First run:
$out1
Second run:
$out"
  fi
  why="exit $rc"
  [ -z "$late" ] || why="they ran past their deadline of ${LIMIT}s and were killed"
  case $rc in
  0) ;;
  2)
    [ -n "$late" ] || hold "the tests could not run on $BR at $at ($WHAT said so: exit 2); $(shown):
$out"
    ;;
  esac
  if [ "$rc" != 0 ]; then
    # The fix is a child: it lands on the train branch through the usual
    # flow, and blocks the train until it closes, so the train is not
    # integrated again unchanged. It starts in backlog, for the yardmaster
    # to shape.
    msg="the tests failed on $BR at $at rebased onto $BASE ($WHAT, $why); $(shown):
$out"
    fix=$(printf '%s\n' "The tests failed on train $TRAIN's branch $BR at $at rebased onto $BASE ($WHAT, $why). Make them pass on $BR. Of the run, $(shown):

$out" | "$Y" bead create "Fix the tests on train $TRAIN" -d "$DEPOT" -t bug -s backlog -b -) &&
      "$Y" dep add "$TRAIN" "$fix" -k parent ||
      hold "$msg
(adding a child to fix it failed; add one, then unhold)"
    report failed "$msg
Added child $fix to fix it; the train is integrated again once it lands."
  fi
  ran="tests passed ($WHAT)"
fi
sha=$(git -C "$REPO" rev-parse --short "$BR")
msg="integrated $BR at $sha onto $BASE; $ran. Review $BASE..$BR."

# Publish the rebased branch, before reporting. A rebase rewrote it, so the
# push may replace the remote's branch, but only when everything there is in
# what was integrated: in $BR as it was before this rebase, or in a tip a
# merger started from. A merger rebases the branch in its worktree without
# pushing it (the merger's role says so), so the remote still has the tip it
# started from, which the conflict note above and the merger's own note
# record as "old tip: <sha>"; those commits are in the branch as rebased.
# Anything else on the remote is someone's commits: never forced over.
if [ -n "$PUSH" ]; then
  tips=$was
  for t in $("$Y" prime --bead "$TRAIN" | grep -o 'old tip: [0-9a-f]\{7,40\}' | awk '{print $3}'); do
    t=$(git -C "$REPO" rev-parse --verify -q "$t^{commit}") && tips="$tips $t"
  done
  within() { for t in $tips; do git -C "$REPO" merge-base --is-ancestor "$1" "$t" 2>/dev/null && return 0; done; return 1; }
  theirs=$(git -C "$REPO" ls-remote "$PUSH" "refs/heads/$BR" | cut -f1)
  if [ -n "$theirs" ] && ! within "$theirs"; then
    why="$PUSH/$BR has commits $BR did not have before the rebase (nor any old tip a merger noted)"
  elif git -C "$REPO" push --force-with-lease="refs/heads/$BR:$theirs" "$PUSH" "$BR" 2>&1; then
    echo "== pushed $BR to $PUSH"
    why=
  else
    why="pushing $BR to $PUSH failed"
  fi
  if [ -n "$why" ] && [ -n "$PR" ]; then
    # A pull request of a branch the remote does not have as integrated
    # would be reviewed and merged as something else.
    case $why in
    *"did not have"*) hold "$msg But $why: not forced, and no pull request opened. Check $PUSH/$BR, then unhold." ;;
    *) report failed "$msg But $why, so no pull request was opened or updated; the next integration retries." ;;
    esac
  fi
  if [ -n "$why" ]; then
    msg="$msg $why (not forced)."
    # Asked only now: a yard names its yardmaster as it likes, and most
    # landings mail nobody.
    [ -n "$NOTIFY" ] || NOTIFY=$("$Y" settings get yardmaster 2>/dev/null) || NOTIFY=yardmaster
    "$Y" mail "$NOTIFY" "integrator: $TRAIN integrated at $sha but $why. Not forced; check $PUSH/$BR." ||
      echo "== could not mail $NOTIFY"
  fi
fi

# The pull request, once the branch it shows is on the remote. Run from the
# depot so gh finds the GitHub repository from its remote. The train's PR is
# the one stored on it, never one looked up by the branch's name: a fork's
# pull request can carry the same name.
if [ -n "$PR" ]; then
  train=$("$Y" bead show "$TRAIN" --json) || report failed "$msg But reading $TRAIN for the pull request failed."
  title=$(printf '%s' "$train" | jq -r .title)
  body=$(
    printf '%s' "$train" | jq -r '.body // ""'
    printf '\n## Children\n\n'
    for c in $(printf '%s' "$train" | jq -r '.children[]?'); do
      printf -- '- %s %s\n' "$c" "$("$Y" bead show "$c" --json | jq -r .title)"
    done
    printf '\nTrain: %s\n' "$TRAIN"
  )
  # stderr apart, so a warning gh prints is not taken for the URL.
  errf=$(mktemp) && trap 'unwatched; rm -f "$errf"' EXIT
  prview() { (cd "$REPO" && gh pr view "$1" --json number,state,headRefName,headRepositoryOwner,headRepository 2>"$errf"); }
  url=$(printf '%s' "$train" | jq -r '.metadata.pr_url // empty')
  bound_num=$(printf '%s' "$train" | jq -r '.metadata.pr_number // empty')
  bound_headrepo=$(printf '%s' "$train" | jq -r '.metadata.pr_head_repo // empty')
  pr=
  if [ -n "$url" ]; then
    pr=$(prview "$url") || report failed "$msg But reading pull request $url failed: $(cat "$errf")"
    # Closed or merged, it is not where this integration goes: a new one is
    # opened and the train bound to that.
    [ "$(printf '%s' "$pr" | jq -r .state)" = OPEN ] || { url=; pr=; }
    if [ -n "$url" ]; then
      actual_num=$(printf '%s' "$pr" | jq -r '.number // empty')
      actual_headrepo=$(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end')
      actual_branch=$(printf '%s' "$pr" | jq -r '.headRefName // empty')
      [ -n "$actual_num" ] && [ -n "$actual_headrepo" ] && [ "$actual_branch" = "$BR" ] ||
        hold "pull request $url no longer has the expected head $BR (GitHub reports #${actual_num:-?} from ${actual_headrepo:-?}:$actual_branch); not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
      [ -z "$bound_num" ] || [ "$actual_num" = "$bound_num" ] ||
        hold "pull request $url is #$actual_num, but $TRAIN is bound to #$bound_num; not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
      [ -z "$bound_headrepo" ] || [ "$actual_headrepo" = "$bound_headrepo" ] ||
        hold "pull request $url is from $actual_headrepo, but $TRAIN is bound to $bound_headrepo; not touched. Correct the train's pr_url, pr_number and pr_head_repo, then unhold."
    fi
  fi
  if [ -n "$url" ]; then
    out=$(cd "$REPO" && printf '%s\n' "$body" | gh pr edit "$url" --body-file - 2>&1) ||
      report failed "$msg But updating pull request $url failed: $out"
    msg="$msg Updated pull request $url."
  else
    out=$(cd "$REPO" && printf '%s\n' "$body" |
      gh pr create --base "$prbase" --head "$BR" --title "$title ($TRAIN)" --body-file - 2>&1) || {
      # One is open for the branch that the train is not bound to (opened by
      # hand, or by an integration that could not store it). Whether it is
      # the train's is a human's call, and no retry changes it.
      case $out in
      *"already exists"*) hold "$msg But a pull request for $BR is open that $TRAIN is not bound to: $out
If it is the train's, bind it (yardr bead update $TRAIN --meta pr_url=<its url>) and unhold; the next integration stores its number and head repository. Otherwise close it, then unhold." ;;
      esac
      report failed "$msg But opening a pull request for $BR failed: $out"
    }
    url=$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*' | tail -n 1)
    [ -n "$url" ] || report failed "$msg But gh pr create printed no URL: $out"
    msg="$msg Opened pull request $url."
  fi
  # Bind the train to this pull request: its number and the repository its
  # head is in are what pr-train, pr-merge and the daemon's github rules
  # hold every later lookup and event against.
  [ -n "$pr" ] || pr=$(prview "$url") || report failed "$msg But reading pull request $url failed: $(cat "$errf")"
  num=$(printf '%s' "$pr" | jq -r '.number // empty')
  headrepo=$(printf '%s' "$pr" | jq -r 'if .headRepositoryOwner.login and .headRepository.name then .headRepositoryOwner.login + "/" + .headRepository.name else empty end')
  [ -n "$num" ] && [ -n "$headrepo" ] ||
    report failed "$msg But pull request $url has no number or head repository: $pr"
  "$Y" bead update "$TRAIN" --meta "pr_url=$url" --meta "pr_number=$num" --meta "pr_head_repo=$headrepo" >/dev/null ||
    report failed "$msg But binding $TRAIN to pull request $url failed."
fi

report done "$msg"
